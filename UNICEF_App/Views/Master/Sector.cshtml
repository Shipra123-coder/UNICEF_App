@model MO.Entities.UNSectorViewModel
@{
    ViewData["Title"] = "Sector";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
}
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<div class="container-fluid py-4">
    <!-- Modern Page Header -->
    <div class="page-header-box d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="page-title-icon">
                <i class="fa fa-th-large"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold text-dark">@ViewData["Title"] Master</h4>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="#">Master Management</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
                <i class="fa fa-database me-1"></i> Master Data
            </span>
        </div>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Add/Edit Card -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <span class="fw-bold">@(Model.FormModel.UNSectorId > 0 ? "Edit Sector" : "Add New Sector")</span>
        </div>
        <div class="card-body">
            <form asp-action="SaveSector" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FormModel.UNSectorId" />
                <input type="hidden" asp-for="FormModel.UNIconUrl" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="FormModel.UNSectorName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="FormModel.UNSectorName" class="form-control" placeholder="e.g. Labour & Employment" />
                        <span asp-validation-for="FormModel.UNSectorName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FormModel.UNSectorCode" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="FormModel.UNSectorCode" class="form-control" placeholder="e.g. LE" />
                        <span asp-validation-for="FormModel.UNSectorCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="FormModel.ColorCode" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input type="color" asp-for="FormModel.ColorCode" class="form-control form-control-color" title="Choose color" />
                            <input type="text" asp-for="FormModel.ColorCode" class="form-control" placeholder="#0d6efd" />
                        </div>
                        <span asp-validation-for="FormModel.ColorCode" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FormModel.IsActive" class="form-label fw-semibold"></label>
                        <select asp-for="FormModel.IsActive" class="form-select">
                            <option value="1">Active</option>
                            <option value="0">Inactive</option>
                        </select>
                    </div>

                    <!-- Icon / Image Upload -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Icon / Image <small class="text-muted">(Max 2MB)</small></label>
                        <input type="file" asp-for="FormModel.UNIconFile" id="fuUNIconFile" class="form-control" accept=".jpg,.jpeg,.png,.webp,.svg" />
                        <span asp-validation-for="FormModel.UNIconFile" class="text-danger small d-block"></span>
                        <span id="fileValidationMsg" class="text-danger small d-none"></span>

                        @if (!string.IsNullOrEmpty(Model.FormModel.UNIconUrl))
                        {
                            <div class="mt-2 d-flex align-items-center gap-2">
                                <img src="@Model.FormModel.UNIconUrl" alt="Current Icon" class="rounded border logo_css" />
                                <small class="text-muted">Current icon</small>
                            </div>
                        }
                    </div>

                    <div class="col-md-12">
                        <label asp-for="FormModel.UNDescription" class="form-label fw-semibold"></label>
                        <textarea asp-for="FormModel.UNDescription" rows="2" class="form-control" placeholder="Focus areas and scope of this UN Sector..."></textarea>
                        <span asp-validation-for="FormModel.UNDescription" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success me-2">
                        @(Model.FormModel.UNSectorId > 0 ? "Update Sector" : "Save Sector")
                    </button>
                    @if (Model.FormModel.UNSectorId > 0)
                    {
                        <a asp-action="Sectors" class="btn btn-secondary">Cancel</a>
                    }
                </div>
            </form>
        </div>
    </div>


    <!-- Data List Card -->
    <div class="card dt-card-wrapper mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-bold text-dark fs-6">Sectors List</h5>
                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold px-2.5 py-1">
                    @(Model.UNSectorList?.Count() ?? 0) Records
                </span>
            </div>
        </div>

        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="unSectorTable">
                    <thead>
                        <tr>
                            <th style="width: 5%;" class="text-center">#</th>
                            <th style="width: 7%;">Icon</th>
                            <th style="width: 14%;">Color</th>
                            <th style="width: 10%;">Code</th>
                            <th style="width: 24%;">Sector Name</th>
                            <th style="width: 22%;">Description</th>
                            <th style="width: 8%;" class="text-center">Status</th>
                            <th style="width: 10%;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.UNSectorList != null && Model.UNSectorList.Any())
                        {
                            int index = 1;
                            foreach (var item in Model.UNSectorList)
                            {
                                <tr>
                                    <td class="text-center text-muted fw-semibold">@index</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.UNIconUrl))
                                        {
                                            <img src="@item.UNIconUrl" alt="Icon" class="table-icon-avatar logo_css" />
                                        }
                                        else
                                        {
                                            <div class="icon-placeholder">N/A</div>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ColorCode))
                                        {
                                            <div class="color-chip">
                                                <span class="color-dot" style="background-color: @item.ColorCode;"></span>
                                                <span>@item.ColorCode</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td><span class="badge-code">@item.UNSectorCode</span></td>
                                    <td><strong>@item.UNSectorName</strong></td>
                                    <td>
                                        <div class="desc-truncate" title="@item.UNDescription">
                                            @(string.IsNullOrEmpty(item.UNDescription) ? "-" : item.UNDescription)
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="ToggleStatusSector" method="post" class="status-toggle-form d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.UNSectorId" />
                                            @if (item.IsActive == 1)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success status-pill-btn">Active</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-secondary status-pill-btn">Inactive</button>
                                            }
                                        </form>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1 justify-content-center">
                                            <a asp-action="Sector" asp-route-id="@item.UNSectorId" class="btn btn-sm btn-light border text-primary action-btn btn-edit" title="Edit">
                                                Edit
                                            </a>
                                            @*<form asp-action="DeleteSector" method="post" class="delete-form d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.UNSectorId" />
                                                    <button type="submit" class="btn btn-sm btn-light border text-danger action-btn" title="Delete">
                                                        Delete
                                                    </button>
                                                </form>*@
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script nonce="@nonce">
        document.addEventListener('DOMContentLoaded', function () {           

            // Client-Side Icon Validation
            const iconInput = document.getElementById('fuUNIconFile');
            const validationMsg = document.getElementById('fileValidationMsg');

            if (iconInput) {
                iconInput.addEventListener('change', function () {
                    const file = this.files[0];
                    const maxSizeBytes = 2 * 1024 * 1024; // 2 MB
                    const allowedExtensions = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp', 'image/svg+xml'];

                    if (!file) {
                        validationMsg.textContent = '';
                        validationMsg.classList.add('d-none');
                        return;
                    }

                    if (file.size > maxSizeBytes) {
                        validationMsg.textContent = 'Icon file size must be less than 2 MB.';
                        validationMsg.classList.remove('d-none');
                        this.value = '';
                        return;
                    }

                    if (!allowedExtensions.includes(file.type) && !file.name.endsWith('.svg')) {
                        validationMsg.textContent = 'Please select a valid image/icon (.jpg, .jpeg, .png, .webp, .svg).';
                        validationMsg.classList.remove('d-none');
                        this.value = '';
                        return;
                    }

                    validationMsg.textContent = '';
                    validationMsg.classList.add('d-none');
                });
            }
        });
    </script>
    <script nonce="@nonce">$(document).ready(function () {
            // Common JS DataTables Initializer
            table.dataTable('unSectorTable');

            // Event Delegation for DataTables Pages (Preserves JS events after page changes)
            $('#unSectorTable').on('click', '.btn-edit', function (e) {
                if (!window.confirm('Are you sure you want to edit this Sector?')) {
                    e.preventDefault();
                }
            });

            $('#unSectorTable').on('submit', '.delete-form', function (e) {
                if (!window.confirm('Are you sure you want to permanently delete this Sector?')) {
                    e.preventDefault();
                }
            });

            $('#unSectorTable').on('submit', '.status-toggle-form', function (e) {
                if (!window.confirm('Do you want to change the status of this Sector?')) {
                    e.preventDefault();
                }
            });
        });</script>
}