@model MO.Entities.GroupViewModel
@{
    ViewData["Title"] = "Group";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
}

<div class="container-fluid py-4">
    <!-- Modern Page Header Box -->
    <div class="page-header-box d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="page-title-icon">
                <i class="fa fa-users"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold text-dark">@ViewData["Title"] Master</h4>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="#">User Management</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
                <i class="fa fa-database me-1"></i> Master Setup
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Add/Edit Card Form -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <span class="fw-bold">@((Model.FormModel.Guid.HasValue && Model.FormModel.Guid != Guid.Empty) ? "Edit Group" : "Add New Group")</span>
        </div>
        <div class="card-body">
            <form asp-action="SaveGroup" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FormModel.Id" />
                <input type="hidden" asp-for="FormModel.Guid" />

                <div class="row g-3">
                    <div class="col-md-5">
                        <label asp-for="FormModel.Name" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="FormModel.Name" class="form-control" placeholder="e.g. Admin, Department, Agency, DES" />
                        <span asp-validation-for="FormModel.Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="FormModel.IsActive" class="form-label fw-semibold"></label>
                        <select asp-for="FormModel.IsActive" class="form-select">
                            <option value="1">Active</option>
                            <option value="0">Inactive</option>
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="FormModel.Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="FormModel.Description" rows="2" class="form-control" placeholder="Enter group mandate or login description..."></textarea>
                        <span asp-validation-for="FormModel.Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success me-2">
                        @((Model.FormModel.Guid.HasValue && Model.FormModel.Guid != Guid.Empty) ? "Update Group" : "Save Group")
                    </button>
                    @if (Model.FormModel.Guid.HasValue && Model.FormModel.Guid != Guid.Empty)
                    {
                        <a asp-action="Group" class="btn btn-secondary">Cancel</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Data List Card -->
    <div class="card dt-card-wrapper mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-bold text-dark fs-6">Group List</h5>
                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold px-2.5 py-1">
                    @(Model.GroupList?.Count() ?? 0) Records
                </span>
            </div>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-modern" id="groupTable">
                    <thead>
                        <tr>
                            <th style="width: 5%;" class="text-center">#</th>
                            <th style="width: 25%;">Group Name</th>
                            <th>Description</th>
                            <th style="width: 18%;">Created Date</th>
                            <th style="width: 8%;" class="text-center">Status</th>
                            <th style="width: 10%;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.GroupList != null && Model.GroupList.Any())
                        {
                            int count = 1;
                            foreach (var item in Model.GroupList)
                            {
                                <tr>
                                    <td class="text-center text-muted fw-semibold">@count</td>
                                    <td><span class="fw-semibold text-dark">@item.Name</span></td>
                                    <td>
                                        <div class="desc-truncate" title="@item.Description">
                                            @(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)
                                        </div>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @(item.CreatedDate.HasValue ? item.CreatedDate.Value.ToString("dd-MMM-yyyy hh:mm tt") : "-")
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="ToggleStatusGroup" method="post" class="status-toggle-form d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="guid" value="@item.Guid" />
                                            @if (item.IsActive == 1)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success status-pill-btn" title="Click to Deactivate">Active</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-secondary status-pill-btn" title="Click to Activate">Inactive</button>
                                            }
                                        </form>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1 justify-content-center">
                                            <a asp-action="Group" asp-route-guid="@item.Guid" class="btn btn-sm btn-light border text-primary action-btn btn-edit" title="Edit Group">
                                                Edit
                                            </a>
                                            <form asp-action="DeleteGroup" method="post" class="delete-form d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="guid" value="@item.Guid" />
                                                <button type="submit" class="btn btn-sm btn-light border text-danger action-btn" title="Delete Group">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                count++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            // Common JS DataTables Initializer
            table.dataTable('groupTable');

            // Event Delegation for DataTables
            $('#groupTable').on('click', '.btn-edit', function (e) {
                if (!window.confirm('Are you sure you want to edit this group?')) {
                    e.preventDefault();
                }
            });

            $('#groupTable').on('submit', '.delete-form', function (e) {
                if (!window.confirm('Are you sure you want to permanently delete this group?')) {
                    e.preventDefault();
                }
            });

            $('#groupTable').on('submit', '.status-toggle-form', function (e) {
                if (!window.confirm('Do you want to change the status of this group?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}