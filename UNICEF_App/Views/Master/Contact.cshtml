@model MO.Entities.ContactViewModel
@using MO.Enums
@{
    ViewData["Title"] = "Contact Us";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
    var nonce = Context.Items["CSPNonce"]?.ToString();
}

<div class="container-fluid py-4">
    <!-- Modern Page Header -->
    <div class="page-header-box d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="page-title-icon">
                <i class="fa fa-address-book"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold text-dark">@ViewData["Title"] Master</h4>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="#">Master Management</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
                <i class="fa fa-database me-1"></i> Master Data
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Add/Edit Card -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <span class="fw-bold">@(Model.FormModel.ContactId > 0 ? "Edit Contact" : "Add New Contact")</span>
        </div>
        <div class="card-body">
            <form asp-action="SaveContact" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FormModel.ContactId" />
                <input type="hidden" asp-for="FormModel.Guid" />
                <input type="hidden" asp-for="FormModel.PhotoUrl" />

                <div class="row g-3">
                    <div class="col-md-3">
                        <label asp-for="FormModel.ContactLevel" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <select asp-for="FormModel.ContactLevel" class="form-select">
                            <option value="">-- Select Level --</option>
                            <option value="@((int)ContactLevelEnum.StateLevel)">State Level</option>                            
                            <option value="@((int)ContactLevelEnum.DepartmentLevel)">Department Level</option>
                            <option value="@((int)ContactLevelEnum.UNAgencies)">UN Agencies</option>
                        </select>
                        <span asp-validation-for="FormModel.ContactLevel" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="FormModel.OfficerName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="FormModel.OfficerName" class="form-control" placeholder="e.g. Dr. Ravi Kumar Surpur, IAS" />
                        <span asp-validation-for="FormModel.OfficerName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="FormModel.Designation" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="FormModel.Designation" class="form-control" placeholder="e.g. Secretary (Planning and Statistics)" />
                        <span asp-validation-for="FormModel.Designation" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="FormModel.EmailId" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="FormModel.EmailId" class="form-control" placeholder="officer@rajasthan.gov.in" />
                        <span asp-validation-for="FormModel.EmailId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="FormModel.OfficeLandline" class="form-label fw-semibold"></label>
                        <input asp-for="FormModel.OfficeLandline" class="form-control" placeholder="e.g. 0141-2227004" />
                        <span asp-validation-for="FormModel.OfficeLandline" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="FormModel.OfficeIpNumber" class="form-label fw-semibold"></label>
                        <input asp-for="FormModel.OfficeIpNumber" class="form-control" placeholder="e.g. 21445" />
                        <span asp-validation-for="FormModel.OfficeIpNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="FormModel.DisplayOrder" class="form-label fw-semibold"></label>
                        <input asp-for="FormModel.DisplayOrder" type="number" class="form-control" placeholder="e.g. 1" />
                        <span asp-validation-for="FormModel.DisplayOrder" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Status</label>
                        <select asp-for="FormModel.IsActive" class="form-select">
                            <option value="1">Active</option>
                            <option value="0">Inactive</option>
                        </select>
                    </div>

                    <!-- Photo Upload with Preview -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Photo <small class="text-muted">(Optional - Max 2MB)</small></label>
                        <input type="file" asp-for="FormModel.PhotoFile" id="fuPhotoFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <span asp-validation-for="FormModel.PhotoFile" class="text-danger small d-block"></span>

                        @if (!string.IsNullOrEmpty(Model.FormModel.PhotoUrl))
                        {
                            <div class="mt-2 d-flex align-items-center gap-2">
                                <img src="@Model.FormModel.PhotoUrl" alt="Current Photo imgcss" class="rounded-circle border" onerror="this.src='/images/default-officer.png';" />
                                <small class="text-muted">Current Photo</small>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success me-2">
                        @(Model.FormModel.ContactId > 0 ? "Update Contact" : "Save Contact")
                    </button>
                    @if (Model.FormModel.ContactId > 0)
                    {
                        <a asp-action="Contact" class="btn btn-secondary">Cancel</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Data List Card -->
    <div class="card dt-card-wrapper mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-bold text-dark fs-6">Contact Directory List</h5>
                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold px-2.5 py-1">
                    @(Model.ContactList?.Count() ?? 0) Records
                </span>
            </div>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-modern" id="contactTable">
                    <thead>
                        <tr>
                            <th style="width: 5%;" class="text-center">#</th>
                            <th style="width: 7%;">Photo</th>
                            <th style="width: 14%;">Level</th>
                            <th style="width: 20%;">Officer Name</th>
                            <th style="width: 20%;">Designation</th>
                            <th>Contact Details</th>
                            <th style="width: 6%;" class="text-center">Order</th>
                            <th style="width: 8%;" class="text-center">Status</th>
                            <th style="width: 10%;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ContactList != null && Model.ContactList.Any())
                        {
                            int index = 1;
                            foreach (var contact in Model.ContactList)
                            {
                                <tr>
                                    <td class="text-center text-muted fw-semibold">@index</td>
                                    <td>
                                        <img src="@(string.IsNullOrEmpty(contact.PhotoUrl) ? "/images/default-officer.png" : contact.PhotoUrl)"
                                             alt="Avatar"
                                             class="rounded-circle border imgcss"                                             
                                             onerror="this.src='/images/default-officer.png';" />
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@contact.ContactLevel</span>
                                    </td>
                                    <td><span class="fw-semibold text-dark">@contact.OfficerName</span></td>
                                    <td><span class="text-dark">@contact.Designation</span></td>
                                    <td>
                                        <small class="d-block text-dark"><strong>Landline:</strong> @(contact.OfficeLandline ?? "N/A")</small>
                                        <small class="d-block text-muted"><strong>IP:</strong> @(contact.OfficeIpNumber ?? "N/A")</small>
                                        <small class="d-block text-muted"><strong>Email:</strong> @contact.EmailId</small>
                                    </td>
                                    <td class="text-center fw-semibold">@contact.DisplayOrder</td>
                                    <td class="text-center">
                                        <form asp-action="ToggleStatusContact" method="post" class="status-toggle-form d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="guid" value="@contact.Guid" />
                                            @if (contact.IsActive == 1)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success status-pill-btn" title="Click to Deactivate">Active</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-secondary status-pill-btn" title="Click to Activate">Inactive</button>
                                            }
                                        </form>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1 justify-content-center">
                                            <a asp-action="Contact" asp-route-guid="@contact.Guid" class="btn btn-sm btn-light border text-primary action-btn btn-edit" title="Edit Contact">
                                                Edit
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@nonce">
        $(document).ready(function () {
            // Common JS DataTables Initializer
            table.dataTable('contactTable');

            // Event Delegation for DataTables Pages
            $('#contactTable').on('click', '.btn-edit', function (e) {
                if (!window.confirm('Are you sure you want to edit this contact?')) {
                    e.preventDefault();
                }
            });

            $('#contactTable').on('submit', '.status-toggle-form', function (e) {
                if (!window.confirm('Do you want to change the status of this contact?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}