@model MO.ViewModels.UserLevelViewModel
@{
    ViewData["Title"] = "User Level";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
}
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}

<div class="container-fluid py-4">
    <!-- Modern Page Header -->
    <div class="page-header-box d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="page-title-icon">
                <i class="fa fa-th-large"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold text-dark">@ViewData["Title"] Master</h4>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="#">Master Management</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
                <i class="fa fa-database me-1"></i> Master Data
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Single Page Form (Create / Edit) -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <span class="fw-bold">@(Model.FormModel.Id > 0 ? "Edit User Level" : "Add New User Level")</span>
        </div>
        <div class="card-body">
            <form asp-action="UserLevelSave" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FormModel.Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FormModel.Name" class="form-label fw-semibold">Level Name</label> <span class="text-danger">*</span>
                        <input asp-for="FormModel.Name" class="form-control" placeholder="Enter level name (e.g. State, District, Block)" />
                        <span asp-validation-for="FormModel.Name" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success me-2">
                        @(Model.FormModel.Id > 0 ? "Update User Level" : "Save User Level")
                    </button>
                    @if (Model.FormModel.Id > 0)
                    {
                        <a asp-action="UserLevel" class="btn btn-secondary">Cancel</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Data List Card -->
    <div class="card dt-card-wrapper mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-bold text-dark fs-6">User Level List</h5>
                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold px-2.5 py-1">
                    @(Model.UserLevelList?.Count() ?? 0) Records
                </span>
            </div>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-modern" id="userLevelTable">
                    <thead>
                        <tr>
                            <th style="width: 10%;" class="text-center"># ID</th>
                            <th style="width: 50%;">Level Name</th>
                            <th style="width: 25%;">Created Date</th>
                            <th style="width: 15%;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.UserLevelList != null && Model.UserLevelList.Any())
                        {
                            foreach (var item in Model.UserLevelList)
                            {
                                <tr>
                                    <td class="text-center text-muted fw-semibold">@item.Id</td>
                                    <td><strong>@item.Name</strong></td>
                                    <td>@(item.CreatedDate.HasValue ? item.CreatedDate.Value.ToString("dd-MMM-yyyy hh:mm tt") : "-")</td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1 justify-content-center">
                                            <a asp-action="UserLevel" asp-route-id="@item.Id" class="btn btn-sm btn-light border text-primary action-btn btn-edit" title="Edit Level">
                                                Edit
                                            </a>
                                            @*<form asp-action="UserLevelDelete" method="post" class="delete-form d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-light border text-danger action-btn" title="Delete Level">
                                                        Delete
                                                    </button>
                                                </form>*@
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script nonce="@nonce">
        $(document).ready(function () {
            // Common JS DataTables Initializer
            table.dataTable('userLevelTable');

            // Event Delegation for DataTables Pages (Works across search, sorting, and pagination)
            $('#userLevelTable').on('click', '.btn-edit', function (e) {
                if (!window.confirm('Are you sure you want to edit this record?')) {
                    e.preventDefault();
                }
            });

            $('#userLevelTable').on('submit', '.delete-form', function (e) {
                if (!window.confirm('Are you sure you want to delete this level?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}