@using MO.Common
@model MO.Master.WorkActivityViewModel
@{
    ViewData["Title"] = "Activity Master";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
}
<form asp-action="SaveActivityWithDepartment" method="post">

    <!-- 🔷 Activity Section -->
    <div class="card mb-3">
        <div class="card-header bg-primary text-white">
            📋 Activity Details
        </div>

        <div class="card-body row">

            <div class="col-md-6">
                <label>Activity Name</label>
                <input asp-for="Activity.ActivityName" class="form-control" required />
            </div>

            <div class="col-md-3">
                <label>Short Name</label>
                <input asp-for="Activity.ShortName" class="form-control" value="HAC" />
            </div>

            <div class="col-md-3">
                <label>Activity Type</label>
                <input asp-for="Activity.ActivityType" class="form-control" value="Field Work" />
            </div>

            <div class="col-md-12 mt-2">
                <label>Description</label>
                <textarea asp-for="Activity.Description" class="form-control">Health awareness program in rural areas </textarea>
            </div>

        </div>
    </div>
    <div class="row">
        <div class="col-6">
            <!-- 🔷 Department Mapping -->
            <div class="card">
                <div class="card-header bg-info text-white">
                    🏢 Department Mapping (Select One Nodal)
                </div>

                <div class="card-body">

                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">

                            <thead class="table-light text-center">
                                <tr>
                                    <th>Select</th>
                                    <th>Department</th>
                                    <th>Nodal</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var dept in Model.DepartmentList)
                                {
                                    <tr>
                                        <!-- Checkbox -->
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   name="SelectedDepartmentIds"
                                                   value="@dept.Id"
                                                   class="dept-checkbox" />
                                        </td>

                                        <!-- Department Name -->
                                        <td>@dept.DepartmentName</td>

                                        <!-- Nodal Radio -->
                                        <td class="text-center">
                                            <input type="radio"
                                                   name="NodalDepartmentId"
                                                   value="@dept.Id"
                                                   class="nodal-radio" />
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>

        </div>
        <div class="col-6">
            <!-- 🔷 Agency Mapping -->
            <div class="card">
                <div class="card-header bg-info text-white">
                    🏢 Agency Mapping (Select One Nodal)
                </div>

                <div class="card-body">

                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">

                            <thead class="table-light text-center">
                                <tr>
                                    <th>Select</th>
                                    <th>Agency</th>
                                    <th>Nodal Agency</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var agn in Model.AgencyList)
                                {
                                    <tr>
                                        <!-- Checkbox -->
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   name="SelectedAgencyIds"
                                                   value="@agn.Id"
                                                   class="dept-checkbox" />
                                        </td>

                                        <!-- Department Name -->
                                        <td>@agn.AgencyName</td>

                                        <!-- Nodal Radio -->
                                        <td class="text-center">
                                            <input type="radio"
                                                   name="NodalAgencyId"
                                                   value="@agn.Id"
                                                   class="nodal-radio" />
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <!-- 🔷 Submit -->
    <div class="text-end mt-3">
        <button type="submit" class="btn btn-success">
            💾 Save Activity
        </button>
    </div>

</form>

