@model MO.ViewModels.SectorViewModel
@{
    ViewData["Title"] = "SubThemes Master";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
}
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}

<div class="container-fluid py-4">
    <!-- Modern Page Header -->
    <div class="page-header-box d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="page-title-icon">
                <i class="fa fa-th-large"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold text-dark">SubThemes Master</h4>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="#">Master Management</a></li>
                        <li class="breadcrumb-item active" aria-current="page">SubThemes</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
                <i class="fa fa-database me-1"></i> Master Data
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Add/Edit Card -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <span class="fw-bold">@(Model.FormModel.SectorId > 0 ? "Edit SubThemes" : "Add New SubThemes")</span>
        </div>
        <div class="card-body">
            <form asp-action="SaveSubThemes" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FormModel.SectorId" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="FormModel.PillarId" class="form-label fw-semibold">Themes</label> <span class="text-danger">*</span>
                        <select asp-for="FormModel.PillarId" asp-items="Model.PillarDropdownList" class="form-select">
                            <option value="">-- Select Themes --</option>
                        </select>
                        <span asp-validation-for="FormModel.PillarId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="FormModel.SectorName" class="form-label fw-semibold">SubThemes Name</label> <span class="text-danger">*</span>
                        <input asp-for="FormModel.SectorName" class="form-control" placeholder="e.g. Transforming Agri-food Systems" />
                        <span asp-validation-for="FormModel.SectorName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Status</label>
                        <select asp-for="FormModel.Status" class="form-select">
                            <option value="1">Active</option>
                            <option value="0">Inactive</option>
                        </select>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="FormModel.Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="FormModel.Description" rows="2" class="form-control" placeholder="Short description (optional)..."></textarea>
                        <span asp-validation-for="FormModel.Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success me-2">
                        @(Model.FormModel.SectorId > 0 ? "Update SubThemes" : "Save SubThemes")
                    </button>
                    @if (Model.FormModel.SectorId > 0)
                    {
                        <a asp-action="SubThemes" class="btn btn-secondary">Cancel</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Data List Card -->
    <div class="card dt-card-wrapper mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-bold text-dark fs-6">SubThemes List</h5>
                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold px-2.5 py-1">
                    @(Model.SectorList?.Count() ?? 0) Records
                </span>
            </div>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-modern" id="subThemesTable">
                    <thead>
                        <tr>
                            <th style="width: 5%;" class="text-center">#</th>
                            <th style="width: 30%;">Themes Name</th>
                            <th style="width: 40%;">SubThemes Name</th>
                            <th style="width: 10%;" class="text-center">Status</th>
                            <th style="width: 15%;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.SectorList != null && Model.SectorList.Any())
                        {
                            int count = 1;
                            foreach (var sec in Model.SectorList)
                            {
                                <tr>
                                    <td class="text-center text-muted fw-semibold">@count</td>
                                    <td>
                                        <span class="badge bg-primary text-wrap text-start">
                                            @(sec.Pillar != null ? sec.Pillar.PillarName : $"Theme ID: {sec.PillarId}")
                                        </span>
                                    </td>
                                    <td><strong>@sec.SectorName</strong></td>
                                    <td class="text-center">
                                        <form asp-action="ToggleStatusSubTheme" method="post" class="status-toggle-form d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@sec.SectorId" />
                                            @if (sec.Status == 1)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success status-pill-btn" title="Click to Deactivate">Active</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-secondary status-pill-btn" title="Click to Activate">Inactive</button>
                                            }
                                        </form>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1 justify-content-center">
                                            <a asp-action="SubThemes" asp-route-id="@sec.SectorId" class="btn btn-sm btn-light border text-primary action-btn btn-edit" title="Edit SubTheme">
                                                Edit
                                            </a>
                                            @*<form asp-action="DeleteSubTheme" method="post" class="delete-form d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@sec.SectorId" />
                                                    <button type="submit" class="btn btn-sm btn-light border text-danger action-btn" title="Delete SubTheme">
                                                        Delete
                                                    </button>
                                                </form>*@
                                        </div>
                                    </td>
                                </tr>
                                count++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script nonce="@nonce">
        $(document).ready(function () {
            // Common JS DataTables Initializer
            table.dataTable('subThemesTable');

            // Event Delegation for DataTables Pages (Preserves JS events across pagination & sorting)
            $('#subThemesTable').on('click', '.btn-edit', function (e) {
                if (!window.confirm('Are you sure you want to edit this SubTheme?')) {
                    e.preventDefault();
                }
            });

            $('#subThemesTable').on('submit', '.delete-form', function (e) {
                if (!window.confirm('Are you sure you want to permanently delete this SubTheme?')) {
                    e.preventDefault();
                }
            });

            $('#subThemesTable').on('submit', '.status-toggle-form', function (e) {
                if (!window.confirm('Do you want to change the status of this SubTheme?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}