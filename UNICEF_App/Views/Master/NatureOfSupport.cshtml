@model MO.Entities.NatureOfSupportViewModel
@{
    ViewData["Title"] = "Nature of Support Master";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
}

<div class="container-fluid py-4">
    <!-- Modern Page Header Box -->
    <div class="page-header-box d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="page-title-icon">
                <i class="fa fa-handshake-o"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold text-dark">Nature of Support Master</h4>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="/Dashboard">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="#">Master Management</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Nature of Support</li>
                    </ol>
                </nav>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-semibold">
                <i class="fa fa-database me-1"></i> Master Setup
            </span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Add/Edit Form Card -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-primary text-white">
            <span class="fw-bold">@(Model.FormModel.NatureSupportId > 0 ? "Edit Nature of Support" : "Add New Nature of Support")</span>
        </div>
        <div class="card-body">
            <form asp-action="SaveNatureOfSupport" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="FormModel.NatureSupportId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FormModel.NatureSupportName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="FormModel.NatureSupportName" class="form-control" placeholder="e.g. Policy Support, Technical Assistance" />
                        <span asp-validation-for="FormModel.NatureSupportName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="FormModel.DisplayOrder" class="form-label fw-semibold"></label>
                        <input type="number" asp-for="FormModel.DisplayOrder" class="form-control" placeholder="e.g. 1, 2, 3..." min="1" />
                        <span asp-validation-for="FormModel.DisplayOrder" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="FormModel.IsActive" class="form-label fw-semibold"></label>
                        <select asp-for="FormModel.IsActive" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success me-2">
                        @(Model.FormModel.NatureSupportId > 0 ? "Update Record" : "Save Record")
                    </button>
                    @if (Model.FormModel.NatureSupportId > 0)
                    {
                        <a asp-action="NatureOfSupport" class="btn btn-secondary">Cancel</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Data List Card -->
    <div class="card dt-card-wrapper mt-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <h5 class="mb-0 fw-bold text-dark fs-6">Nature of Support List</h5>
                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary fw-semibold px-2.5 py-1">
                    @(Model.NatureOfSupportList?.Count() ?? 0) Records
                </span>
            </div>
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-modern" id="natureOfSupportTable">
                    <thead>
                        <tr>
                            <th style="width: 8%;" class="text-center"># ID</th>
                            <th style="width: 45%;">Nature of Support Name</th>
                            <th style="width: 15%;" class="text-center">Display Order</th>
                            <th style="width: 14%;">Created Date</th>
                            <th style="width: 8%;" class="text-center">Status</th>
                            <th style="width: 10%;" class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.NatureOfSupportList != null && Model.NatureOfSupportList.Any())
                        {
                            foreach (var item in Model.NatureOfSupportList)
                            {
                                <tr>
                                    <td class="text-center text-muted fw-semibold">@item.NatureSupportId</td>
                                    <td><span class="fw-semibold text-dark">@item.NatureSupportName</span></td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">
                                            @(item.DisplayOrder.HasValue ? item.DisplayOrder.Value.ToString() : "-")
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @item.CreatedDate.ToString("dd-MMM-yyyy hh:mm tt")
                                        </small>
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="ToggleStatusNatureOfSupport" method="post" class="status-toggle-form d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.NatureSupportId" />
                                            @if (item.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success status-pill-btn" title="Click to Deactivate">Active</button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-secondary status-pill-btn" title="Click to Activate">Inactive</button>
                                            }
                                        </form>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1 justify-content-center">
                                            <a asp-action="NatureOfSupport" asp-route-id="@item.NatureSupportId" class="btn btn-sm btn-light border text-primary action-btn btn-edit" title="Edit Record">
                                                Edit
                                            </a>
                                            <form asp-action="DeleteNatureOfSupport" method="post" class="delete-form d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.NatureSupportId" />
                                                <button type="submit" class="btn btn-sm btn-light border text-danger action-btn" title="Delete Record">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            // Common JS DataTables Initializer
            table.dataTable('natureOfSupportTable');

            // Event Delegation for DataTables
            $('#natureOfSupportTable').on('click', '.btn-edit', function (e) {
                if (!window.confirm('Are you sure you want to edit this record?')) {
                    e.preventDefault();
                }
            });

            $('#natureOfSupportTable').on('submit', '.delete-form', function (e) {
                if (!window.confirm('Are you sure you want to permanently delete this record?')) {
                    e.preventDefault();
                }
            });

            $('#natureOfSupportTable').on('submit', '.status-toggle-form', function (e) {
                if (!window.confirm('Do you want to change the status of this record?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}