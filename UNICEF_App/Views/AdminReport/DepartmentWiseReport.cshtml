<section class="best-practice-page margin-top-new">
    <div class="container mt-4">
        <!-- 🌟 MODERN TOP FILTER CARD 🌟 -->
        <!-- 🌟 MODERN TOP FILTER CARD 🌟 -->
        <div class="top-filter">
            <div class="filter-header">
                <i class="bx bx-filter-alt"></i> <span>Filters</span>
            </div>
            <div class="row align-items-end g-3">
                <div class="col-md-4 col-lg-5">
                    <label for="Agency" class="form-label fw-bold text-secondary">
                        Select Agency <span class="text-danger">*</span>
                    </label>
                    <select class="form-select form-select-md" name="Agency" id="Agency">
                        <option value="-1">Select Agency</option>
                    </select>
                    <input type="hidden" id="hiddenAgencyId" value="@ViewBag.AgencyId" />
                </div>
                <div class="col-md-4 col-lg-5">
                    <label for="Sector" class="form-label fw-bold text-secondary">
                        Select Sector <span class="text-danger">*</span>
                    </label>
                    <select class="form-select form-select-md" name="Sector" id="Sector">
                        <option value="-1">Select Sector</option>
                    </select>
                    <input type="hidden" id="hiddenSectorId" value="@ViewBag.Sector" />
                </div>
                <div class="col-md-4 col-lg-7 d-flex gap-2 justify-content-md-start">
                    <button type="button" id="btnLoadReport" class="btn btn-primary btn-filter">
                        <i class="bx bx-search-alt"></i> Load Report
                    </button>
                    <button type="button" id="btnPrintReport" class="btn btn-success btn-filter">
                        <i class="bx bx-printer"></i> Print Report
                    </button>
                </div>
            </div>
        </div>

        <!-- 🌟 PRINT AREA CONTAINER 🌟 -->
        <div id="printDiv" class="d-none">
            <div class="report">
                <div class="report-title text-center text-primary mb-3">
                    <h2>Activities Progress Report</h2>
                    <h3><span id="lblAgencyHeaderName_head" class="headert-tit"></span></h3>
                </div>

                <!-- TOP SUMMARY CARDS -->
                <div class="summary-card-container">
