                            <span class="summary-label">Sectors</span>
                        </div>
                    </div>

                    <!-- 3. Activities -->
                    <div class="summary-card card-yellow">
                        <div class="summary-icon bg-icon-blue"><i class="bx bx-notepad"></i></div>
                        <div class="summary-data">
                            <span class="summary-value" id="lblActivitiesCount">0</span>
                            <span class="summary-label">Activities</span>
                        </div>
                    </div>

                    <!-- 4. Tasks -->
                    <div class="summary-card card-red">
