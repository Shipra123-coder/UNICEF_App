                        </div>
                    </div>
                </div>*@

                <!-- DYNAMIC CONTENT RENDER CONTAINER -->
                <div id="activityReportContainer">
                    <div class="text-center my-4 text-muted">
                        <p class="mb-0">Please select an Agency and click "Load Report" to view details.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

