<script nonce="@nonce">
    document.addEventListener('DOMContentLoaded', function () {
        var hiddenAgencyElem = document.getElementById('hiddenAgencyId');
        var hiddenAgencyVal = hiddenAgencyElem ? hiddenAgencyElem.value : '';

        var hiddenSectorElem = document.getElementById('hiddenSectorId');
        var hiddenSectorVal = hiddenSectorElem ? hiddenSectorElem.value : '';

        // 1. Get logged-in DepartmentId from ViewBag
        var departmentId = '@ViewBag.DepartmentId' || '-1';

        // 2. Bind Agency and Sector Dropdowns
        if (typeof common !== 'undefined' && common.BindDropdown) {
            common.BindDropdown(`/Master/DDL_Agency`, "Agency", "Agency", hiddenAgencyVal);
            common.BindDropdown(`/Master/DDL_UNSector`, "Sector", "Sector", hiddenSectorVal);
        }

        // 3. Filter Button Click Listener
        var btnLoad = document.getElementById('btnLoadReport');
        if (btnLoad) {
            btnLoad.addEventListener('click', function () {
                var agencyElem = document.getElementById('Agency');
                var agencyId = agencyElem ? agencyElem.value : '-1';

                var sectorElem = document.getElementById('Sector');
                var sectorId = sectorElem ? sectorElem.value : '-1';

                // Proceed directly without validation alerts
                var printDiv = document.getElementById('printDiv');
                if (printDiv) {
                    printDiv.classList.remove('d-none');
                }

                if (typeof printDepartmentReport !== 'undefined') {
                    // Pass exactly as defined in JS: (agencyId, departmentId, sectorId)
                    printDepartmentReport.loadDepartmentWiseData(departmentId,agencyId, sectorId);
                }
            });
        }

        // 4. Auto Load on Page Load
        if (departmentId !== '' && departmentId !== '-1') {
            setTimeout(() => {
                var printDiv = document.getElementById('printDiv');
                if (printDiv) {
                    printDiv.classList.remove('d-none');
                }
                if (typeof printDepartmentReport !== 'undefined') {
                    var loadAgency = hiddenAgencyVal ? hiddenAgencyVal : '-1';
                    var loadSector = hiddenSectorVal ? hiddenSectorVal : '-1';

                    // Pass exactly as defined in JS: (agencyId, departmentId, sectorId)
                    printDepartmentReport.loadDepartmentWiseData(departmentId,loadAgency,loadSector);
                }
            }, 500);
        }

        // 5. Print Report Button Event Listener
        var btnPrint = document.getElementById('btnPrintReport');
        if (btnPrint) {
            btnPrint.addEventListener('click', function () {
                if (typeof printDepartmentReport !== 'undefined') {
                    printDepartmentReport.printDiv('@nonce');
                }
            });
        }
    });
</script>