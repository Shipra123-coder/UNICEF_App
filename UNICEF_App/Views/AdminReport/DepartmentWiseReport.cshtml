                        <div class="summary-data">
                            <span class="summary-value" id="lblTasksCount">0</span>
                            <span class="summary-label">Tasks</span>
                        </div>
                    </div>

                    <!-- 5. Best Practices -->
                    <div class="summary-card card-purple">
