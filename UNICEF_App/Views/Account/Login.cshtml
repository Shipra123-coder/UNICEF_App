@model MO.Login.loginModels.loginCredentials
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
@{
    var returnUrl = Convert.ToString(Context.Request.Query["ReturnUrl"]);
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<style nonce="@nonce">
    .gradient-form {
        background-color: #eee;
    }

    .gradient-custom-2 {
        /* fallback for old browsers */
        background: #fccb90;
        /* Chrome 10-25, Safari 5.1-6 */
        background: -webkit-linear-gradient(to right, #ee7724, #d8363a, #dd3675, #b44593);
        /* W3C, IE 10+/ Edge, Firefox 16+, Chrome 26+, Opera 12+, Safari 7+ */
        background: linear-gradient(to right, #ee7724, #d8363a, #dd3675, #b44593);
    }

    .pynew-5 {
        padding-top: 10rem !important;
    }

    @@media (min-width: 768px) {
        .gradient-form {
            height: 100vh !important;
        }
    }

    @@media (min-width: 769px) {
        .gradient-custom-2 {
            border-top-right-radius: .3rem;
            border-bottom-right-radius: .3rem;
        }
    }

    .mt-6 {
        margin-top: 6rem !important;
    }

    .color-white {
        color: #fff;
    }
</style>
<style nonce="@nonce">
    body {
        background: #f4f7fb;
        overflow-x: hidden;
    }
    /* =====================================
           MAIN SECTION
        ===================================== */
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 15px;
    }
    /* =====================================
           CARD
        ===================================== */
    .login-card {
        width: 100%;
        max-width: 1050px;
        background: #fff;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 15px 45px rgba(0,0,0,0.08);
    }
    /* =====================================
           LEFT SIDE
        ===================================== */
    .login-left {
        padding: 55px 45px;
        background: #ffffff;
    }

    .logo-img {
        width: 170px;
        margin-bottom: 20px;
    }

    .login-title {
        font-size: 28px;
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 8px;
    }

    .login-subtitle {
        color: #64748b;
        margin-bottom: 35px;
        font-size: 15px;
    }
    /* =====================================
           FORM
        ===================================== */
    .form-label {
        font-size: 14px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 8px;
    }

    .myform input {
        width: 100%;
        height: 50px;
        border-radius: 12px;
        border: 1px solid #dbe4f0;
        padding: 12px 15px;
        font-size: 14px;
        transition: 0.3s;
        outline: none;
    }

        .myform input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37,99,235,0.10);
        }

    .input-group-text {
        border-radius: 0 12px 12px 0 !important;
        background: #fff;
        border: 1px solid #dbe4f0;
        border-left: 0;
        cursor: pointer;
    }

    #Password {
        border-radius: 12px 0 0 12px !important;
    }
    /* =====================================
           BUTTON
        ===================================== */
    #btn_login {
        width: 100%;
        height: 52px;
        border: none;
        border-radius: 14px;
        background: linear-gradient( 135deg, #2563eb, #7c3aed );
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        transition: 0.3s;
        margin-top: 10px;
    }

        #btn_login:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(37,99,235,0.25);
        }

    /* =====================================
           RIGHT SIDE
        ===================================== */

    .login-right {
        background: linear-gradient( 135deg, #1e3a8a, #7c3aed );
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px;
        position: relative;
        overflow: hidden;
    }

        .login-right::before {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,0.08);
            border-radius: 50%;
            top: -100px;
            right: -100px;
        }

        .login-right::after {
            content: '';
            position: absolute;
            width: 220px;
            height: 220px;
            background: rgba(255,255,255,0.06);
            border-radius: 50%;
            bottom: -80px;
            left: -80px;
        }

    .right-content {
        position: relative;
        z-index: 5;
        color: #fff;
    }

        .right-content h4 {
            font-size: 34px;
            font-weight: 800;
            margin-bottom: 20px;
            line-height: 1.3;
        }

        .right-content p {
            font-size: 15px;
            line-height: 1.8;
            opacity: 0.95;
        }

    #btn_login {
        min-width: 180px;
        border-radius: 30px;
        font-weight: 600;
    }

    /* =====================================
           RESPONSIVE
        ===================================== */

    @@media(max-width:991px) {

        .login-left {
            padding: 40px 25px;
        }

        .login-right {
            padding: 40px 25px;
        }

        .right-content h4 {
            font-size: 26px;
        }
    }

    @@media(max-width:767px) {

        .login-card {
            border-radius: 16px;
        }

        .login-right {
            display: none;
        }

        .login-left {
            padding: 35px 20px;
        }

        .login-title {
            font-size: 24px;
        }
    }
</style>
<link href="~/public/css/instyle.css" rel="stylesheet" />
<div class="login-wrapper">
    <div class="container cmpad margin-top">
        <div class="row">
            <div class="col-lg-12 pe-lg-4 mb-4 mb-lg-0">
                <div class="vismis">
                    <div class="vis-sec mb-lg-3 mb-xl-4 mb-xxl-5 mb-4 mb-lg-0 p-0">
                        <div class="row g-0">
                            <div class="col-lg-6 login-left">
                                <div class="card-body p-md-2">

                                    <div class="text-center">
                                        <h4 class="login-title">Please login to your account</h4>
                                    </div>
                                    <form class="row myform mb-3"
                                          id="myForm"
                                          asp-action="Login"
                                          asp-controller="Account"
                                          method="post"
                                          autocomplete="off">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" id="nonce" name="nonce" value="@ViewData["loginNonce"]" />

                                        <div class="col-12 mb-3">
                                            <label asp-for="Username" class="form-label"></label>
                                            <input asp-for="Username"
                                                   class="form-control alphanumeric_username"
                                                   placeholder="Username"
                                                   maxlength="20"
                                                   autocomplete="off" />
                                            <span asp-validation-for="Username" class="text-danger"></span>
                                        </div>

                                        <div class="col-12 mb-3">
                                            <label asp-for="Password" class="form-label"></label>

                                            <div class="input-group" id="show_hide_password">
                                                <input id="Password"
                                                       type="password"
                                                       class="form-control border-end-0"
                                                       maxlength="20"
                                                       placeholder="Password"
                                                       autocomplete="off" />

                                                <input type="hidden" id="HashedPassword" name="HashedPassword" />

                                                <a href="javascript:;" class="input-group-text bg-white">
                                                    <i class="bx bx-hide"></i>
                                                </a>
                                            </div>
                                            <div asp-validation-summary="All"
                                                 class="text-danger">
                                            </div>
                                            @*<span asp-validation-for="Password" class="text-danger"></span>*@
                                        </div>

                                        <!-- Center Login Button -->
                                        <div class="col-12 text-center mt-3">
                                            <button type="submit"
                                                    class="btn btn-primary px-5"
                                                    id="btn_login">
                                                Sign In
                                            </button>
                                        </div>

                                    </form>
                                </div>
                            </div>
                            <div class="col-lg-6 d-flex align-items-center login-right">
                                <div class="right-content">
                                    <h4 class="mb-4 lni-text-align-center color-white">Rajasthan UN Activity Dashboard</h4>
                                    <p class="small mb-0 text-align-justify color-white">
                                        UN Activity in Rajasthan refers to the state government’s system for tracking and reporting progress on the Sustainable Development Goals (SDGs) in alignment with the United Nations Agenda 2030.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style nonce="@nonce">
    .margin_top {
        margin-top: 26%;
        margin-bottom: 1%;
    }

    .bg_color {
        background: rgb(3,40,92);
        background: linear-gradient(0deg, rgba(3,40,92,1) 0%, rgba(191,29,62,1) 100%);
        margin: auto !important;
    }

    .bg_card {
        color: #fff;
        border: 0px;
        margin-top: -230px !important;
    }

    .color-white {
        color: #fff;
    }
</style>
<script nonce="@nonce" src="~/js/crypto-js.min.js" asp-append-version="true"></script>
<script nonce="@nonce">
    document.addEventListener("DOMContentLoaded", function () {

        const form = document.getElementById("myForm");
        const button = document.getElementById("btn_login");

        let submitted = false;

        form.addEventListener("submit", function (e) {

            if (submitted) {
                e.preventDefault();
                return false;
            }

            submitted = true;

            button.disabled = true;
            button.innerText = "Please wait...";
        });

    });
</script>
<script nonce="@nonce">

    document.getElementById("myForm")
        .addEventListener("submit", async function () {
            debugger;
            const passwordInput =
                document.getElementById("Password");

            const nonce =
                document.getElementById("nonce").value;

            const hashedInput =
                document.getElementById("HashedPassword");

            const password =
                passwordInput.value;

            const hash =
                CryptoJS.SHA256(password + nonce)
                    .toString(CryptoJS.enc.Hex);

            hashedInput.value = hash;

            // remove plaintext password
            passwordInput.value = "";

        });

</script>
<script nonce="@nonce">
    document.addEventListener("DOMContentLoaded", function () {
        debugger;
        const passwordInput = document.getElementById("Password");
        const nonceInput = document.getElementById("nonce");
        const hashedInput = document.getElementById("HashedPassword");

        async function updateHash() {
            const password = passwordInput.value;
            const nonce = nonceInput.value;
            const salted = password + nonce;

            const hash = await hashPassword(salted);
            hashedInput.value = hash;
            console.log("Hashed password:", hash);
        }

        // Event listeners
        passwordInput.addEventListener("keyup", updateHash);
        passwordInput.addEventListener("input", updateHash);
    });

    async function hashPassword(text) {
        const hash = CryptoJS.SHA256(text).toString(CryptoJS.enc.Hex);
        console.log("Client Hash:", hash);
        return hash;
    }

</script>