@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<style nonce="@nonce">
    /* Green themed chips for Sectors */
    .sector-chip {
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #c8e6c9;
        padding: 5px 12px;
        border-radius: 50px;
        display: inline-flex;
        align-items: center;
        margin-right: 8px;
        margin-bottom: 8px;
        font-size: 13px;
        font-weight: 500;
        animation: slideUp 0.3s ease;
    }

    .btn-remove-sector {
        border: none;
        background: transparent;
        color: #c62828;
        margin-left: 10px;
        font-size: 18px;
        cursor: pointer;
        line-height: 1;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
<div class="bg-white p-4 border rounded mb-4 shadow-sm">
    <h6 class="text-secondary fw-bold border-bottom pb-2 mb-3">
        <i class="fas fa-chart-pie me-2"></i> Sector Mapping
    </h6>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="small fw-bold text-success">Main Sector (Primary) *</label>
            <select class="form-select border-success" name="mainSector" id="mainSectorSelect">
                <option value="">-- Select Main Sector --</option>
                <option value="Agri">Transforming Agri-Food Systems</option>
                <option value="Health">Health and Well-being</option>
                <option value="Education">Education and Knowledge Economy</option>
                <option value="Industrial">Industrial, Mining and Economic Growth</option>
                <option value="Infrastructure">Core Infrastructure</option>
            </select>
        </div>

        <div class="col-md-6 mb-3">
            <label class="small fw-bold">Add Supporting Sectors (Multiple)</label>
            <div class="input-group">
                <select id="supportingSectorSelect" class="form-select">
                    <option value="">-- Choose Supporting Sector --</option>
                    <option value="Social">Social Empowerment and Inclusion</option>
                    <option value="Tourism">Tourism and Cultural Development</option>
                    <option value="Water">Water Security and Resilience</option>
                    <option value="Environment">Environmental Sustainability</option>
                    <option value="Rural">Rural Development</option>
                    <option value="Urban">Urban Development</option>
                </select>
                <button class="btn btn-success" type="button" id="btnAddSector">
                    <i class="fas fa-plus"></i> Add
                </button>
            </div>

            <div id="sectorChipsContainer" class="mt-3 d-flex flex-wrap">
            </div>

            <input type="hidden" name="supportingSectorsList" id="hiddenSupportingSectors">
        </div>
    </div>
</div>
<script nonce="@nonce">
    document.addEventListener('DOMContentLoaded', function() {
        // Sector Mapping Elements
        const btnAddSector = document.getElementById('btnAddSector');
        const sectorSelect = document.getElementById('supportingSectorSelect');
        const sectorChipsContainer = document.getElementById('sectorChipsContainer');
        const hiddenSectorInput = document.getElementById('hiddenSupportingSectors');

        let selectedSectors = [];

        // 1. Add Sector Logic
        btnAddSector.addEventListener('click', function() {
            const sectorId = sectorSelect.value;
            const sectorName = sectorSelect.options[sectorSelect.selectedIndex].text;

            if (!sectorId) {
                alert("Please select a sector first.");
                return;
            }

            if (selectedSectors.includes(sectorId)) {
                alert("This sector is already added.");
                return;
            }

            selectedSectors.push(sectorId);

            const chip = document.createElement('div');
            chip.className = 'sector-chip';
            chip.innerHTML = `
                <span>${sectorName}</span>
                <button type="button" class="btn-remove-sector" data-id="${sectorId}">&times;</button>
            `;

            sectorChipsContainer.appendChild(chip);
            updateSectorHiddenInput();
            sectorSelect.value = "";
        });

        // 2. Remove Sector Logic (Event Delegation)
        sectorChipsContainer.addEventListener('click', function(e) {
            if (e.target.classList.contains('btn-remove-sector')) {
                const idToRemove = e.target.getAttribute('data-id');
                selectedSectors = selectedSectors.filter(id => id !== idToRemove);
                e.target.closest('.sector-chip').remove();
                updateSectorHiddenInput();
            }
        });

        function updateSectorHiddenInput() {
            hiddenSectorInput.value = selectedSectors.join(',');
        }
    });
</script>