@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
}
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<style nonce="@nonce">
    .radio-group {
        padding-left: 20px;
        margin-top: 5px;
    }

    .specify-section {
        /* display: none; */
        border-left: 3px solid #27ae60;
        padding-left: 20px;
        margin-top: 15px;
    }

    .options-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .doc-item.full-width {
        grid-column: span 2;
    }

    .upload-box {
        margin-top: 5px;
    }

    .support-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        padding: 15px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 5px;
    }

    .support-item {
        padding: 8px;
        border-bottom: 1px solid #f0f0f0;
    }

        .support-item label {
            font-size: 14px;
            cursor: pointer;
        }

    .hidden {
        display: none;
    }

    .form-card {
        /* max-width: 900px; */
        margin: 0 auto;
        background: #fff;
        border: 1px solid #000;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    .form-header {
        background-color: var(--header-yellow);
        color: #000;
        padding: 15px;
        text-align: center;
        font-weight: bold;
        font-size: 1.2rem;
        border-bottom: 1px solid #000;
    }

    .form-body {
        padding: 25px;
    }
</style>
<input type="hidden" value="@ViewBag.guid" id="hiddenActivityGuid" />

<div class="form-card">
    <div class="form-header">
        Format ‘A’ : UN Agency Monitoring Entry Form
    </div>
    <table id="basicdetail" class="table table-bordered">
        <tr>
            <td>Name of UN Agency</td>
            <td><strong>: UNICEF </strong></td>
        </tr>
        <tr>
            <td>Activity</td>
            <td><strong>: Implementation of COVID 19 Vaccination system (CoWIN)</strong></td>
        </tr>
        <tr>
            <td>Name of the Department</td>
            <td><strong>: Education</strong></td>
        </tr>
        <tr>
            <td>Associated Department</td>
            <td><strong>: Education, Education, Education</strong></td>
        </tr>
    </table>

    <div class="row">
        <div class="col-full mb-3">
            <label class="fw-bold">Is partnership governed by written commitment?</label>
            <div class="support-grid">
                <div class="radio-group">
                    <input type="radio" name="partnership" value="Yes" id="radioYes"
                           @(ViewBag.MonitoringData?.IsPartnership == "Yes" ? "checked" : "")> Yes
                    <input type="radio" name="partnership" value="No" id="radioNo"
                           @(ViewBag.MonitoringData?.IsPartnership == "No" ? "checked" : "")> No
                </div>
            </div>
        </div>

        <!-- Specify Section -->
        <div class="col-full specify-section @(ViewBag.MonitoringData?.IsPartnership == "Yes" ? "" : "d-none")" id="specifySection">

            <label class="fw-bold mb-2">
                If Yes, Specify (Document Type) & Upload Copy*
            </label>

            <div class="support-grid options-container">

                @foreach (var item in ViewBag.AllDocuments)
                {
                    var selected = ((List<MO.Management.DocumentModel>)ViewBag.MonitoringData?.Documents ?? new List<MO.Management.DocumentModel>())
                    .FirstOrDefault(x => x.DocumentType == item);

                    var isChecked = selected != null;
                    var fileName = selected?.FileName ?? "";

                    // 🔥 SAFE ID (special chars remove)
                    var safeId = "doc_" + System.Text.RegularExpressions.Regex.Replace(item, "[^a-zA-Z0-9]", "");

                    <div class="doc-item">
                        <label>
                            <input type="checkbox"
                                   class="doc-check"
                                   data-target="@safeId"
                                   @(isChecked ? "checked" : "") />

                            @item
                        </label>

                        <div id="@safeId" class="upload-box @(isChecked ? "" : "d-none")">

                            <input type="file" class="form-control-sm">
                            <input type="hidden" class="existing-file" value="@fileName" />
                            @if (!string.IsNullOrEmpty(fileName))
                            {
                                <small class="text-success">Uploaded: @fileName</small>
                            }
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

    <!-- Financial -->
    <div class="row">
        <div class="col">
            <label class="fw-bold mb-2">Total Financial Commitment</label>
            <div class="support-grid">
                <!-- 🔹 DIRECT -->
                <div class="doc-item">
                    <label class="fw-bold text-primary">Direct</label>
                    <div class="input-group mb-2">
                        <span class="input-group-text">₹</span>
                        <input type="number" step="0.01" class="form-control" id="directINR" placeholder="INR (Lakhs)"
                               value="@ViewBag.MonitoringData?.DirectINR">
                    </div>
                    <div class="input-group mb-2">
                        <span class="input-group-text">$</span>
                        <input type="number" step="0.01" class="form-control" id="directUSD" placeholder="USD"
                               value="@ViewBag.MonitoringData?.DirectUSD">
                    </div>
                    <input type="text" class="form-control form-control-sm" placeholder="Source"
                           value="@ViewBag.MonitoringData?.DirectSource">
                </div>

                <!-- 🔹 INDIRECT -->
                <div class="doc-item">
                    <label class="fw-bold text-success">Indirect</label>
                    <div class="input-group mb-2">
                        <span class="input-group-text">₹</span>
                        <input type="number" step="0.01" class="form-control" id="indirectINR" placeholder="INR (Lakhs)"
                               value="@ViewBag.MonitoringData?.IndirectINR">
                    </div>
                    <div class="input-group mb-2">
                        <span class="input-group-text">$</span>
                        <input type="number" step="0.01" class="form-control" id="indirectUSD" placeholder="USD"
                               value="@ViewBag.MonitoringData?.IndirectUSD">
                    </div>
                    <input type="text" class="form-control form-control-sm" placeholder="Source"
                           value="@ViewBag.MonitoringData?.IndirectSource">
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-full mb-3">
            <label class="fw-bold mb-2">Nature of support provided by UN Agency</label>

            <div class="support-grid">

                @foreach (var item in ViewBag.AllSupports)
                {
                    var selected = ((List<MO.Management.SupportModel>)ViewBag.SelectedSupports)
                    .FirstOrDefault(x => x.SupportType == item);

                    var isChecked = selected != null;
                    var details = selected?.Details ?? "";

                    // 🔥 SAFE ID
                    var safeId = "txt_" + System.Text.RegularExpressions.Regex.Replace(item, "[^a-zA-Z0-9]", "");

                    <div class="support-item">
                        <label>
                            <input type="checkbox"
                                   class="support-check"
                                   data-target="@safeId"
                                   @(isChecked ? "checked" : "") />

                            @item
                        </label>

                        <div id="@safeId" class="support-text @(isChecked ? "" : "d-none")">
                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter details..."
                                   value="@details" />
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

    <button type="button" class="btn-primary" id="saveBtn">Submit Data</button>
</div>
<script nonce="@nonce" src="~/custom/activitymonitor.js"></script>
<script nonce="@nonce">
          document.addEventListener('DOMContentLoaded', function () {

        const saveBtn = document.getElementById('saveBtn');

        saveBtn.addEventListener('click', async function () {
            await activityMonitor.saveMonitoringData();
        }); // 🔥 WAIT


    });</script>
<script nonce="@nonce">
        $(document).ready(function () {
        let guid = $('#ActivityGuid').val();
        if (guid && guid !== "") {
            activityMonitor.getMonitoringData(guid);
        }

    });
</script>
<script nonce="@nonce">
    document.addEventListener("DOMContentLoaded", function () {

        // 🔹 Radio Buttons (Yes/No)
        const radioYes = document.getElementById("radioYes");
        const radioNo = document.getElementById("radioNo");
        // 🔥 IMPORTANT FIX
        toggleQ1(radioYes && radioYes.checked);

        if (radioYes && radioNo) {
            radioYes.addEventListener("change", function () {
                toggleQ1(this.checked);
            });

            radioNo.addEventListener("change", function () {
                toggleQ1(!this.checked);
            });
        }

        document.querySelectorAll(".support-check").forEach(function (checkbox) {

        checkbox.addEventListener("change", function () {

            const targetId = this.getAttribute("data-target");
            const targetDiv = document.getElementById(targetId);

            if (targetDiv) {
                targetDiv.classList.toggle("d-none", !this.checked);
            }
        });

    });
     document.querySelectorAll(".doc-check").forEach(function (checkbox) {

        checkbox.addEventListener("change", function () {

            const targetId = this.getAttribute("data-target");
            const targetDiv = document.getElementById(targetId);

            if (targetDiv) {
                targetDiv.classList.toggle("d-none", !this.checked);
            }

        });

    });
        // // 🔹 Generic Toggle (data-toggle)
        // document.querySelectorAll("[data-toggle]").forEach(function (el) {
        //     el.addEventListener("change", function () {
        //         const target = this.getAttribute("data-toggle");
        //         const targetEl = document.getElementById(target);

        //         if (targetEl) {
        //             targetEl.style.display = this.checked ? "block" : "none";
        //         }
        //     });
        // });

        // 🔹 Other (Specify with Upload)
        const checkOther = document.getElementById("checkOther");
        if (checkOther) {
            checkOther.addEventListener("change", function () {
                toggleOtherWithUpload();
            });
        }

        // 🔹 Support Other
        const checkSupportOther = document.getElementById("checkSupportOther");
        if (checkSupportOther) {
            checkSupportOther.addEventListener("change", function () {
                toggleSupportOther();
            });
        }

    });


    // 🔸 Functions

        function toggleQ1(show) {
        const el = document.getElementById("specifySection");

        if (el) {
            if (show) {
                el.classList.remove("d-none");   // show
            } else {
                el.classList.add("d-none");      // hide
            }
        }
    }

    function toggleOtherWithUpload() {
        const check = document.getElementById("checkOther");
        const div = document.getElementById("uploadOtherContainer");

        if (check && div) {
            div.style.display = check.checked ? "block" : "none";
        }
    }

    function toggleSupportOther() {
        const check = document.getElementById("checkSupportOther");
        const div = document.getElementById("supportOtherInputDiv");

        if (check && div) {
            div.style.display = check.checked ? "block" : "none";
        }
    }
</script>


