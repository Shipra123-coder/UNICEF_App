@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<style nonce="@nonce">
     .mapping-box {
         background: #fdfdfd;
         border: 1px solid #dee2e6;
         border-radius: 8px;
         padding: 20px;
     }

     /* Grouped Goal Card */
     .goal-group-card {
         background: #fff;
         border: 1px solid #e0e0e0;
         border-radius: 8px;
         margin-bottom: 20px;
         overflow: hidden;
         box-shadow: 0 4px 6px rgba(0,0,0,0.07);
         border-left: 5px solid #6610f2;
     }

     /* Header with Full Goal Remove */
     .goal-group-header {
         background: #f8f6ff;
         color: #6610f2;
         padding: 12px 15px;
         font-weight: bold;
         border-bottom: 1px solid #eee;
         display: flex;
         justify-content: space-between;
         align-items: center;
     }

     .target-list-container {
         padding: 5px 15px;
         background: #fff;
     }

     /* Target Entry with Remove */
     .target-entry {
         display: flex;
         justify-content: space-between;
         align-items: center;
         padding: 10px 0;
         border-bottom: 1px solid #f1f1f1;
     }

         .target-entry:last-child {
             border-bottom: none;
         }

     .target-name {
         font-size: 13.5px;
         color: #444;
         display: flex;
         align-items: center;
     }

         .target-name::before {
             content: "\f05b";
             font-family: "Font Awesome 5 Free";
             font-weight: 900;
             color: #6610f2;
             margin-right: 12px;
             font-size: 10px;
         }

     /* Buttons */
     .btn-remove-target {
         color: #dc3545;
         border: 1px solid transparent;
         background: #fff5f5;
         cursor: pointer;
         padding: 2px 8px;
         border-radius: 4px;
         font-size: 12px;
         transition: 0.2s;
     }

         .btn-remove-target:hover {
             background: #dc3545;
             color: #fff;
             border-color: #dc3545;
         }

     .btn-remove-goal {
         font-size: 11px;
         text-transform: uppercase;
         letter-spacing: 0.5px;
         font-weight: 700;
         border-radius: 4px;
         padding: 4px 10px;
     }

     .empty-state {
         text-align: center;
         color: #999;
         padding: 40px;
         border: 2px dashed #dee2e6;
         border-radius: 10px;
     }
</style>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-primary"><i class="fas fa-project-diagram me-2"></i> Goal & Target Hierarchy</h5>
        <span id="totalCountBadge" class="badge bg-primary">0 Targets Total</span>
    </div>

    <div class="card-body bg-light">
        <div class="mapping-box shadow-sm mb-4">
            <div class="row align-items-end">
                <div class="col-md-5 mb-3">
                    <label class="small fw-bold">1. Select Strategic Goal</label>
                    <select class="form-select" id="Goal" name="Goal">                      
                    </select>
                </div>
                <div class="col-md-5 mb-3">
                    <label class="small fw-bold">2. Select Linked Target</label>
                    <select class="form-select" id="Target" name="Target">                      
                    </select>
                </div>
                <div class="col-md-2 mb-3">
                    <button type="button" id="btnAddMapping" class="btn btn-primary w-100 fw-bold shadow-sm">
                        <i class="fas fa-plus-circle"></i> Add
                    </button>
                </div>
            </div>
        </div>

        <div id="mappingContainer">
            <div class="empty-state">
                <i class="fas fa-layer-group fa-3x mb-3 opacity-25"></i>
                <p>No goals or targets mapped yet. Use the form above to start.</p>
            </div>
        </div>

        <input type="hidden" name="mappingJsonData" id="mappingJsonData">

        @* <div class="text-end border-top pt-3">
            <button type="button" id="SaveMapping" class="btn btn-primary px-5 shadow">Save & Proceed</button>
        </div>   *@     
    </div>
</div>
