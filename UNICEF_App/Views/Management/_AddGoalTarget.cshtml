<script nonce="@nonce">
    $(function () {
        const goal = document.getElementById('Goal');
        goal.addEventListener('change', function(e) {
            const selectedGoalId = e.target.value;
            console.log("Selected Goal ID:", selectedGoalId);
            common.BindDropdown(`/Master/DDL_Target?GoalId=` + selectedGoalId, "Target", "Target", $('#hiddentargetId').val());
        });
    });
</script>
<script nonce="@nonce">
    document.addEventListener('DOMContentLoaded', function() {
        const goalDropdown = document.getElementById('Goal');
        const targetDropdown = document.getElementById('Target');
        const btnAdd = document.getElementById('btnAddMapping');
        const mappingContainer = document.getElementById('mappingContainer');
        const hiddenInput = document.getElementById('mappingJsonData');
        const totalCountBadge = document.getElementById('totalCountBadge');

       

        // ADD LOGIC
        btnAdd.addEventListener('click', function() {
            const gId = goalDropdown.value;
            const gName = goalDropdown.options[goalDropdown.selectedIndex].text;
            const tId = targetDropdown.value;
            const tName = targetDropdown.options[targetDropdown.selectedIndex].text;

            if (!gId || !tId) { alert("Goal aur Target dono select karein."); return; }

            if (!mappingData[gId]) {
                mappingData[gId] = { name: gName, targets: [] };
            }

            const exists = mappingData[gId].targets.some(t => t.id === tId);
            if (exists) { alert("Yeh target pehle se add hai."); return; }

            mappingData[gId].targets.push({ id: tId, name: tName });
            renderUI();
            targetDropdown.value = "";
        });

        // RENDER UI
        function renderUI() {
            const goalIds = Object.keys(mappingData);
            if (goalIds.length === 0) {
                mappingContainer.innerHTML = '<div class="empty-state"><i class="fas fa-layer-group fa-3x mb-3 opacity-25"></i><p>No goals or targets mapped yet.</p></div>';
                totalCountBadge.textContent = "0 Targets Total";
                hiddenInput.value = "";
                return;
            }

            mappingContainer.innerHTML = '';
            let totalTargets = 0;

            goalIds.forEach(gId => {
                const goal = mappingData[gId];
                totalTargets += goal.targets.length;

                const card = document.createElement('div');
                card.className = 'goal-group-card';

                let targetHtml = '';
                goal.targets.forEach((t, idx) => {
                    targetHtml += `
                        <div class="target-entry">
                            <span class="target-name">${t.name}</span>
                            <button type="button" class="btn-remove-target" data-goal="${gId}" data-target-idx="${idx}">
                                <i class="fas fa-times me-1"></i> Remove
                            </button>
                        </div>`;
                });

                card.innerHTML = `
                    <div class="goal-group-header">
                        <span><i class="fas fa-bullseye me-2"></i> ${goal.name}</span>
                        <button type="button" class="btn btn-outline-danger btn-sm btn-remove-goal" data-goal="${gId}">
                            <i class="fas fa-trash-alt me-1"></i> Remove Full Goal
                        </button>
                    </div>
                    <div class="target-list-container">
                        ${targetHtml}
                    </div>
                `;
                mappingContainer.appendChild(card);
            });

            totalCountBadge.textContent = `${totalTargets} Targets Total`;
            hiddenInput.value = JSON.stringify(mappingData);
        }

        // REMOVE LOGIC (Event Delegation)
        mappingContainer.addEventListener('click', function(e) {
            // 1. Remove Single Target
            const btnT = e.target.closest('.btn-remove-target');
            if (btnT) {
                const gId = btnT.getAttribute('data-goal');
                const tIdx = btnT.getAttribute('data-target-idx');
                mappingData[gId].targets.splice(tIdx, 1);
                if (mappingData[gId].targets.length === 0) delete mappingData[gId];
                renderUI();
                return;
            }

            // 2. Remove Full Goal
            const btnG = e.target.closest('.btn-remove-goal');
            if (btnG) {
                const gId = btnG.getAttribute('data-goal');
                if (confirm("Kya aap is Goal aur iske saare Targets ko hatana chahte hain?")) {
                    delete mappingData[gId];
                    renderUI();
                }
            }
        });
    });
</script>