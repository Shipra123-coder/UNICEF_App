@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<style nonce="@nonce">
    .dept-chip {
        background: #e3f2fd;
        color: #0d47a1;
        border: 1px solid #bbdefb;
        padding: 5px 12px;
        border-radius: 50px;
        display: inline-flex;
        align-items: center;
        margin-right: 8px;
        margin-bottom: 8px;
        font-size: 13px;
        font-weight: 500;
        animation: fadeIn 0.3s ease;
    }

    .btn-remove-dept {
        border: none;
        background: transparent;
        color: #d32f2f;
        margin-left: 10px;
        font-size: 18px;
        cursor: pointer;
        line-height: 1;
    }

        .btn-remove-dept:hover {
            color: #b71c1c;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
<div class="bg-white p-4 border rounded mb-4 shadow-sm">
    <h6 class="text-secondary fw-bold border-bottom pb-2 mb-3">
        Department Mapping
    </h6>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="small fw-bold text-danger">Nodal Department (Primary) *</label>
            <select class="form-select form-select-sm" name="Department" id="Department">
                <option value="-1">--Select Department--</option>
            </select>          
        </div>

        <div class="col-md-6 mb-3">
            <label class="small fw-bold">Associated Departments</label>
            <div class="input-group">
                <select class="form-select form-select-sm" name="SubDepartment" id="SubDepartment">
                    <option value="-1">--Select Associated Departments--</option>
                </select>             
                <button class="btn btn-primary" type="button" id="btnAddDept">Add</button>
            </div>
            <div id="deptChipsContainer" class="mt-3 d-flex flex-wrap"></div>
        </div>

        @* <div class="text-end border-top pt-3">
            <button type="button" id="SbtnSave" class="btn btn-primary px-5 shadow">Save & Proceed</button>
        </div> *@
    </div>
</div>
<script nonce="@nonce">
      document.addEventListener('DOMContentLoaded', function() {
          common.BindDropdown(`/Master/DDL_Department`, "Department", "Department", $('#hiddenDeptId').val());

          //  const SbtnSave = document.getElementById('SbtnSave');
          //  // Add Sub-Activity Block
          // SbtnSave.addEventListener('click', function() {
          //  activityMaster.saveDept();
          // });
    });</script>
<script nonce="@nonce">
    $(function () {        
        const nodalDept = document.getElementById('Department');

        nodalDept.addEventListener('change', function(e) {
            const selectedDeptId = e.target.value;
            console.log("Selected Department ID:", selectedDeptId);   
            common.BindDropdown(`/Master/DDL_SupDepartment?Id=` + selectedDeptId, "SubDepartment", "Associated Departments", $('#hiddensupDeptId').val());
 
        
        });
        
    });
</script>
<script nonce="@nonce">
    document.addEventListener('DOMContentLoaded', function() {
        const btnAddDept = document.getElementById('btnAddDept');
        const deptSelect = document.getElementById('SubDepartment');
        const chipsContainer = document.getElementById('deptChipsContainer');
        const hiddenInput = document.getElementById('hiddenSupportingDepts');

        let selectedDepts = []; // Array to keep track of IDs

        // 1. Add Department Function
        btnAddDept.addEventListener('click', function() {
            const deptId = deptSelect.value;
            const deptName = deptSelect.options[deptSelect.selectedIndex].text;

            if (!deptId) {
                alert("Please select a department first.");
                return;
            }

            // Check if already added
            if (selectedDepts.includes(deptId)) {
                alert("This department is already added as a supporting department.");
                return;
            }

            // Add to Array
            selectedDepts.push(deptId);

            // Create Chip UI
            const chip = document.createElement('div');
            chip.className = 'dept-chip';
            chip.innerHTML = `
                <span>${deptName}</span>
                <button type="button" class="btn-remove-dept" data-id="${deptId}">&times;</button>
            `;

            chipsContainer.appendChild(chip);
            updateHiddenInput();

            // Reset Select
            deptSelect.value = "-1";
        });

        chipsContainer.addEventListener("click", function (e) {

            const removeBtn = e.target.closest(".btn-remove-dept");

            if (!removeBtn) return;

            const idToRemove = removeBtn.dataset.id;

            selectedDepts = selectedDepts.filter(x => x != idToRemove);

            removeBtn.closest(".dept-chip").remove();

            updateHiddenInput();

        });
        //// 2. Remove Department Function (Using Event Delegation)
        //chipsContainer.addEventListener('click', function(e) {
        //    if (e.target.classList.contains('btn-remove-dept')) {
        //        const idToRemove = e.target.getAttribute('data-id');

        //        // Remove from Array
        //        selectedDepts = selectedDepts.filter(id => id !== idToRemove);

        //        // Remove from UI
        //        e.target.closest('.dept-chip').remove();

        //        updateHiddenInput();
        //    }
        //});

        // 3. Sync Array with Hidden Input for ASP.NET Postback
        function updateHiddenInput() {
            hiddenInput.value = selectedDepts.join(',');
        }
    });
</script>