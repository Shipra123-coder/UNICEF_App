@model MO.Management.ActivityMaster
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<style nonce="@nonce">
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: none;
    }

    .input-group-text {
        font-size: 12px;
        font-weight: bold;
        min-width: 70px;
    }

    .sub-activity-block {
        transition: transform 0.2s;
    }

        .sub-activity-block:hover {
            transform: scale(1.005);
        }
</style>
<style nonce="@nonce">
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: none;
    }

    .input-group-text {
        font-size: 12px;
        font-weight: bold;
        min-width: 70px;
    }

    .sub-activity-block {
        transition: transform 0.2s;
    }

        .sub-activity-block:hover {
            transform: scale(1.005);
        }

    .agency-chip {
        font-size: 0.85rem;
        padding: 5px 10px;
    }
</style>
<div class="card shadow border-0">
    <div class="card-body bg-light">
        <div class="bg-white p-3 border rounded mb-4 shadow-sm">
            <h6 class="text-secondary fw-bold border-bottom pb-2 mb-3">Main Activity Details</h6>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="small fw-bold">Activity Name</label>
                    <input type="text" class="form-control" id="activityName" name="activityName" value="@Model?.ActivityName" placeholder="Activity Name">
                </div>
                <div class="col-md-2 mb-3">
                    <label class="small fw-bold">Short Name</label>
                    <input type="text" class="form-control" id="shortName" name="shortName" value="@Model?.ShortName" placeholder="Short Name">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="small fw-bold">Sector</label>
                    <input type="hidden" id="hiddenunsector" value="@Model.UNSector" />
                    <select class="form-select" id="UNSector" name="UNSector" asp-for="@Model.UNSector">
                    </select>
                </div>
            </div>
            <div class="row">
                <!-- DESCRIPTION -->
                <div class="col-md-12 mb-3">
                    <label class="small fw-bold">
                        Description
                    </label>
                    <textarea class="form-control"
                              id="Description"
                              name="Description"
                              rows="1">@Model?.Description</textarea>

                </div>
            </div>
            <div class="row">

                <!-- ACTIVITY PERIOD -->
                <div class="col-md-6 mb-3">

                    <label class="small fw-bold mb-2 d-block">
                        Activity Period
                    </label>

                    <div class="input-group shadow-sm">

                        <!-- START DATE -->
                        <span class="input-group-text bg-primary text-white">
                            <i class="bx bx-calendar"></i>
                        </span>
                        <input type="text"
                               class="form-control datepicker"
                               id="StartDate"
                               name="StartDate"
                               placeholder="dd-mm-yyyy"
                               value="@Model?.StartDate">
                        @* <input type="date"
                            class="form-control"
                            id="StartDate"
                            name="StartDate"
                            value="@Model?.StartDate"> *@

                        <!-- TO -->
                        <span class="input-group-text bg-light fw-bold">
                            To
                        </span>

                        <!-- END DATE -->
                        <input type="text"
                               class="form-control datepicker"
                               id="EndDate"
                               name="EndDate"
                               value="@Model?.EndDate">

                    </div>

                    <!-- VALIDATION MESSAGE -->
                    <small id="dateValidation"
                           class="text-danger d-none">
                        End Date must be greater than or equal to Start Date
                    </small>
                </div>
            </div>
        </div>
        <div class="bg-white p-3 border rounded mb-4 shadow-sm">
            <label class="fw-bold me-3">Do you want to add Sub-Activities?</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="hasSubActivity" id="subYes" value="1"
                       @(Model?.HasSubActivity == true ? "checked" : "")>
                <label class="form-check-label" for="subYes">Yes</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="hasSubActivity" id="subNo" value="0"
                       @(Model?.HasSubActivity == false ? "checked" : "")>
                <label class="form-check-label" for="subNo">No</label>
            </div>
        </div>
        <input type="hidden" id="DeletedSubIds" value="" />
        <input type="hidden" id="DeletedTaskIds" value="" />
        <div id="subActivityWrapper" style="display:@(Model?.HasSubActivity == true ? "block" : "none")">
            @if (Model?.SubActivities != null && Model.SubActivities.Count > 0)
            {
                int subIndex = 1;
                foreach (var sub in Model.SubActivities)
                {
                    <div class="sub-activity-block mb-4 p-3 bg-white border rounded shadow-sm" style="border-left: 5px solid #0d6efd !important;">
                        <input type="hidden" class="sub-id" name="SubActivityId[]" value="@sub.SubActivityId" />

                        <div class="row mb-3 align-items-center">
                            <div class="col-md-9">
                                <label class="fw-bold text-primary">Sub-Activity @subIndex Name</label>
                                <input type="text" class="form-control form-control-lg" name="SubActivityName[]" value="@sub.SubActivityName" placeholder="Enter sub-activity name...">
                            </div>
                            <div class="col-md-3 text-end pt-4">
                                <button type="button" class="btn btn-sm btn-outline-danger btn-remove-sub">
                                    <i class="bx bx-trash"></i> Remove Sub
                                </button>
                            </div>
                        </div>

                        <div class="task-section p-2 bg-light rounded">
                            <div class="task-list">

                                @if (sub.Tasks != null && sub.Tasks.Count > 0)
                                {
                                    int taskIndex = 1;
                                    foreach (var task in sub.Tasks)
                                    {
                                        <div class="border rounded p-3 mb-3 bg-white task-item">
                                            <div class="row">
                                                <div class="col-md-12 mb-3">
                                                    <label class="small fw-bold">Task Description</label>
                                                    <div class="input-group">
                                                        <span class="input-group-text bg-white task-number">Task @taskIndex</span>

                                                        <input type="hidden" class="task-id" name="TaskId[]" value="@task.TaskId" />
                                                        <input type="text" class="form-control" name="Tasks[]" value="@task.TaskDescription" placeholder="Enter task detail..." />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-12 mb-3">
                                                    <label class="small fw-bold">Task Detailed Description</label>

                                                    <textarea class="form-control"
                                                              name="TaskDetailDescription[]"
                                                              rows="3"
                                                              placeholder="Enter task detailed description...">@task.TaskDetailDescription</textarea>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-8 mb-2">
                                                    <label class="small fw-bold">Task Period</label>
                                                    <div class="input-group shadow-sm">
                                                        <span class="input-group-text bg-primary text-white">
                                                            <i class="bx bx-calendar"></i>
                                                        </span>
                                                        <input type="text" class="form-control task-start-date datepicker" name="TaskStartDate[]" value="@task.StartDate" placeholder="dd-mm-yyyy" autocomplete="off" />
                                                        <span class="input-group-text bg-light fw-bold">To</span>
                                                        <input type="text" class="form-control task-end-date datepicker" name="TaskEndDate[]" value="@task.EndDate" placeholder="dd-mm-yyyy" autocomplete="off" />
                                                    </div>
                                                    <small class="text-danger d-none task-date-validation">
                                                        End Date must be greater than or equal to Start Date
                                                    </small>
                                                </div>

                                                <div class="col-md-4 d-flex align-items-end justify-content-end gap-2 mb-2">
                                                    <button class="btn btn-outline-secondary btn-add-task" type="button">
                                                        <i class="bx bx-plus"></i>
                                                    </button>
                                                    <button class="btn btn-outline-danger btn-remove-task" type="button">
                                                        <i class="bx bx-trash"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- ASSOCIATED AGENCY SECTION -->
                                            <div class="row">
                                                <div class="col-md-12 mb-3">
                                                    <label class="small fw-bold">Associated Agency</label>
                                                    <div class="input-group">
                                                        <select class="form-select form-select-sm associatedAgency" name="AssociatedAgency[]">
                                                            <option value="-1">--Select Associated Agency--</option>
                                                        </select>
                                                        <button class="btn btn-primary btnAddAssoAgency" type="button">Add</button>
                                                    </div>
                                                    <div class="agencyChipsContainer mt-2 d-flex flex-wrap gap-1"></div>
                                                    <input type="hidden" class="selectedAgencyIds" name="TaskAgencyIds[]" value="@task.TaskAgencyIds" />
                                                </div>
                                            </div>
                                        </div>
                                        taskIndex++;
                                    }
                                }
                                else
                                {
                                    <div class="border rounded p-3 mb-3 bg-white task-item">
                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label class="small fw-bold">Task Description</label>
                                                <div class="input-group">
                                                    <span class="input-group-text bg-white task-number">Task 1</span>
                                                    <input type="hidden" class="task-id" name="TaskId[]" value="0" />
                                                    <input type="text" class="form-control" name="Tasks[]" placeholder="Enter task detail..." />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label class="small fw-bold">Task Detailed Description</label>

                                                <textarea class="form-control"
                                                          name="TaskDetailDescription[]"
                                                          rows="3"
                                                          placeholder="Enter task detailed description..."></textarea>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-8 mb-2">
                                                <label class="small fw-bold">Task Period</label>
                                                <div class="input-group shadow-sm">
                                                    <span class="input-group-text bg-primary text-white"><i class="bx bx-calendar"></i></span>
                                                    <input type="text" class="form-control task-start-date datepicker" name="TaskStartDate[]" placeholder="dd-mm-yyyy" autocomplete="off" />
                                                    <span class="input-group-text bg-light fw-bold">To</span>
                                                    <input type="text" class="form-control task-end-date datepicker" name="TaskEndDate[]" placeholder="dd-mm-yyyy" autocomplete="off" />
                                                </div>
                                                <small class="text-danger d-none task-date-validation">
                                                    End Date must be greater than or equal to Start Date
                                                </small>
                                            </div>
                                            <div class="col-md-4 d-flex align-items-end justify-content-end gap-2 mb-2">
                                                <button class="btn btn-outline-secondary btn-add-task" type="button"><i class="bx bx-plus"></i></button>
                                                <button class="btn btn-outline-danger btn-remove-task" type="button"><i class="bx bx-trash"></i></button>
                                            </div>
                                        </div>
                                        <!-- ASSOCIATED AGENCY SECTION -->
                                        <div class="row">
                                            <div class="col-md-12 mb-3">
                                                <label class="small fw-bold">Associated Agency</label>
                                                <div class="input-group">
                                                    <select class="form-select form-select-sm associatedAgency" name="AssociatedAgency[]">
                                                        <option value="-1">--Select Associated Agency--</option>
                                                    </select>
                                                    <button class="btn btn-primary btnAddAssoAgency" type="button">Add</button>
                                                </div>
                                                <div class="agencyChipsContainer mt-2 d-flex flex-wrap gap-1"></div>
                                                <input type="hidden" class="selectedAgencyIds" name="TaskAgencyIds[]" />
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                    subIndex++;
                }
            }
            else
            {
                <div class="sub-activity-block mb-4 p-3 bg-white border rounded shadow-sm" style="border-left: 5px solid #0d6efd !important;">
                    <input type="hidden" class="sub-id" name="SubActivityId[]" value="0" />
                    <div class="row mb-3 align-items-center">
                        <div class="col-md-9">
                            <label class="fw-bold text-primary">Sub-Activity Name</label>
                            <input type="text" class="form-control form-control-lg" name="SubActivityName[]" placeholder="Enter Sub-Activity">
                        </div>
                    </div>
                    <!-- TASK SECTION -->
                    <div class="task-section p-2 bg-light rounded">

                        <div class="task-list">

                            <div class="border rounded p-3 mb-3 bg-white task-item">

                                <!-- TASK NAME -->
                                <div class="row">

                                    <div class="col-md-12 mb-3">

                                        <label class="small fw-bold">
                                            Task Description
                                        </label>

                                        <div class="input-group">

                                            <span class="input-group-text bg-white">
                                                Task 1
                                            </span>

                                            <input type="hidden"
                                                   class="task-id"
                                                   name="TaskId[]"
                                                   value="0" />

                                            <input type="text"
                                                   class="form-control"
                                                   name="Tasks[]"
                                                   placeholder="Enter task detail..." />

                                        </div>

                                    </div>

                                </div>
                                <!-- TASK Description -->
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <label class="small fw-bold">Task Detailed Description</label>

                                        <textarea class="form-control"
                                                  name="TaskDetailDescription[]"
                                                  rows="3"
                                                  placeholder="Enter task detailed description..."></textarea>
                                    </div>
                                </div>

                                <!-- TASK PERIOD -->
                                <div class="row">

                                    <div class="col-md-6 mb-2">

                                        <label class="small fw-bold">
                                            Task Period
                                        </label>

                                        <div class="input-group shadow-sm">

                                            <span class="input-group-text bg-primary text-white">
                                                <i class="bx bx-calendar"></i>
                                            </span>

                                            <!-- START DATE -->

                                            <input type="text"
                                                   class="form-control task-start-date datepicker"
                                                   name="TaskStartDate[]" />

                                            <span class="input-group-text bg-light fw-bold">
                                                To
                                            </span>

                                            <!-- END DATE -->

                                            <input type="text"
                                                   class="form-control task-end-date datepicker"
                                                   name="TaskEndDate[]" />

                                        </div>

                                        <!-- VALIDATION -->

                                        <small class="text-danger d-none task-date-validation">

                                            End Date must be greater than or equal to Start Date

                                        </small>

                                    </div>

                                    <!-- BUTTONS -->

                                    <div class="col-md-6 d-flex align-items-end justify-content-end gap-2 mb-2">

                                        <button class="btn btn-outline-secondary btn-add-task"
                                                type="button">

                                            <i class="bx bx-plus"></i>

                                        </button>

                                        <button class="btn btn-outline-danger btn-remove-task"
                                                type="button">

                                            <i class="bx bx-trash"></i>

                                        </button>

                                    </div>

                                </div>

                                <!-- ASSOCIATED AGENCY SECTION -->
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <label class="small fw-bold">Associated Agency</label>
                                        <div class="input-group">
                                            <select class="form-select form-select-sm associatedAgency" name="AssociatedAgency[]">
                                                <option value="-1">--Select Associated Agency--</option>
                                            </select>
                                            <button class="btn btn-primary btnAddAssoAgency" type="button">Add</button>
                                        </div>
                                        <div class="agencyChipsContainer mt-2 d-flex flex-wrap gap-1"></div>
                                        <input type="hidden" class="selectedAgencyIds" name="TaskAgencyIds[]" />
                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            }

            <button type="button" id="btnAddSubActivity" class="btn btn-info text-white w-100 mb-3 shadow-sm">
                <i class="fas fa-layer-group"></i> + Add Another Sub-Activity Block
            </button>
        </div>
        <div id="onlyTaskSection" style="display:@(Model?.HasSubActivity == false ? "block" : "none")">
            <div class="bg-white p-3 border rounded shadow-sm mb-4">
                <h6 class="text-secondary fw-bold border-bottom pb-2 mb-3">
                    Tasks
                </h6>
                <div id="mainTaskList">
                    @if (Model?.Tasks != null && Model.Tasks.Count > 0)
                    {
                        foreach (var task in Model.Tasks)
                        {
                            <div class="border rounded p-3 mb-3 bg-light task-item">
                                <!-- TASK NAME -->
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <label class="small fw-bold">
                                            Task Description
                                        </label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white">
                                                Task
                                            </span>
                                            <input type="hidden"
                                                   name="TaskId[]"
                                                   value="@task.TaskId" />

                                            <input type="text"
                                                   class="form-control"
                                                   name="Tasks[]"
                                                   value="@task.TaskDescription"
                                                   placeholder="Enter task detail">
                                        </div>
                                    </div>
                                </div>
                                <!-- TASK Description -->
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <label class="small fw-bold">Task Detailed Description</label>

                                        <textarea class="form-control"
                                                  name="TaskDetailDescription[]"
                                                  rows="3"
                                                  placeholder="Enter task detailed description...">@task.TaskDetailDescription</textarea>
                                    </div>
                                </div>
                                <!-- TASK PERIOD -->
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <label class="small fw-bold">
                                            Task Period
                                        </label>
                                        <div class="input-group shadow-sm">
                                            <span class="input-group-text bg-primary text-white">
                                                <i class="bx bx-calendar"></i>
                                            </span>
                                            <!-- START DATE -->
                                            <input type="text"
                                                   class="form-control task-start-date datepicker"
                                                   name="TaskStartDate[]"
                                                   value="@task.StartDate" />
                                            <span class="input-group-text bg-light fw-bold">
                                                To
                                            </span>
                                            <!-- END DATE -->
                                            <input type="text"
                                                   class="form-control task-end-date datepicker"
                                                   name="TaskEndDate[]"
                                                   value="@task.EndDate" />
                                        </div>

                                        <!-- VALIDATION -->
                                        <small class="text-danger d-none task-date-validation">
                                            End Date must be greater than or equal to Start Date
                                        </small>
                                    </div>

                                    <!-- BUTTONS -->

                                    <div class="col-md-6 d-flex align-items-end justify-content-end gap-2 mb-2">

                                        <button class="btn btn-outline-secondary btn-add-main-task"
                                                type="button">

                                            <i class="bx bx-plus"></i>

                                        </button>

                                        <button class="btn btn-outline-danger btn-remove-main-task"
                                                type="button">

                                            <i class="bx bx-trash"></i>

                                        </button>

                                    </div>

                                </div>
                                <!-- ASSOCIATED AGENCY -->
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <label class="small fw-bold">Associated Agency</label>
                                        <div class="input-group">
                                            <select class="form-select form-select-sm associatedAgency" name="AssociatedAgency[]">
                                                <option value="-1">--Select Associated Agency--</option>
                                            </select>
                                            <button class="btn btn-primary btnAddAssoAgency" type="button">Add</button>
                                        </div>
                                        <div class="agencyChipsContainer mt-2 d-flex flex-wrap gap-1"></div>
                                        <input type="hidden" class="selectedAgencyIds" name="TaskAgencyIds[]" value="@task.TaskAgencyIds" />
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="border rounded p-3 mb-3 bg-light task-item">

                            <!-- TASK NAME -->

                            <div class="row">

                                <div class="col-md-12 mb-3">

                                    <label class="small fw-bold">
                                        Task Description
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text bg-white">
                                            Task
                                        </span>

                                        <input type="hidden"
                                               name="TaskId[]"
                                               value="0" />

                                        <input type="text"
                                               class="form-control"
                                               name="Tasks[]"
                                               placeholder="Enter task detail">

                                    </div>

                                </div>

                            </div>
                            <!-- TASK Description -->
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="small fw-bold">Task Detailed Description</label>

                                    <textarea class="form-control"
                                              name="TaskDetailDescription[]"
                                              rows="3"
                                              placeholder="Enter task detailed description..."></textarea>
                                </div>
                            </div>
                            <!-- TASK PERIOD -->
                            <div class="row">

                                <div class="col-md-6 mb-2">

                                    <label class="small fw-bold">
                                        Task Period
                                    </label>

                                    <div class="input-group shadow-sm">

                                        <span class="input-group-text bg-primary text-white">
                                            <i class="bx bx-calendar"></i>
                                        </span>

                                        <!-- START DATE -->

                                        <input type="text"
                                               class="form-control task-start-date datepicker"
                                               name="TaskStartDate[]" />

                                        <span class="input-group-text bg-light fw-bold">
                                            To
                                        </span>

                                        <!-- END DATE -->

                                        <input type="text"
                                               class="form-control task-end-date datepicker"
                                               name="TaskEndDate[]" />

                                    </div>

                                    <!-- VALIDATION -->

                                    <small class="text-danger d-none task-date-validation">

                                        End Date must be greater than or equal to Start Date

                                    </small>

                                </div>

                                <!-- BUTTON -->

                                <div class="col-md-6 d-flex align-items-end justify-content-end gap-2 mb-2">

                                    <button class="btn btn-outline-secondary btn-add-main-task"
                                            type="button">

                                        <i class="bx bx-plus"></i>

                                    </button>

                                </div>

                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="small fw-bold">Associated Agency</label>
                                    <div class="input-group">
                                        <select class="form-select form-select-sm associatedAgency" name="AssociatedAgency[]">
                                            <option value="-1">--Select Associated Agency--</option>
                                        </select>
                                        <button class="btn btn-primary btnAddAssoAgency" type="button">Add</button>
                                    </div>
                                    <div class="agencyChipsContainer mt-2 d-flex flex-wrap gap-1"></div>
                                    <input type="hidden" class="selectedAgencyIds" name="TaskAgencyIds[]" />
                                </div>
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>
    </div>
</div>
<script nonce="@nonce">
    document.addEventListener('DOMContentLoaded', function () {

        // ======================================
        // GLOBAL VARIABLES & INITIALIZATION
        // ======================================
        let deletedTaskIds = [];
        let deletedSubIds = [];

        // Dropdown binding
        if (typeof common !== 'undefined' && common.BindDropdown) {
            common.BindDropdown("/Master/DDL_UNSector", "UNSector", "Sector", $('#hiddenunsector').val());

        }

        // 2. Function to bind Agency Dropdowns
        function bindAgencyDropdowns(container = document) {
            if (typeof common !== 'undefined' && common.BindDropdown) {
                $(container).find('.associatedAgency').each(function (index) {
                    let $elem = $(this);

                    if (!$elem.hasClass('bound')) {
                        // 1. Check karein agar ID nahi hai toh unique ID generate karke assign karein
                        let elementId = $elem.attr('id');
                        if (!elementId) {
                            elementId = 'agency_ddl_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
                            $elem.attr('id', elementId);
                        }

                        // 2. common.BindDropdown me jQuery object $(this) ki jagah String ID (elementId) pass karein
                        common.BindDropdown("/Master/DDL_Agency", elementId, "Associated Agency", "");

                        // 3. Mark as bound
                        $elem.addClass('bound');
                    }
                });
            }
        }

        // Bind agencies on initial load
        bindAgencyDropdowns();

        // ======================================
        // 2. 🌟 LOAD & RENDER SAVED AGENCY CHIPS ON PAGE LOAD
        // ======================================
        // ======================================
        // 2. 🌟 LOAD & RENDER SAVED AGENCY CHIPS ON PAGE LOAD (FIXED NAME MAPPING)
        // ======================================
        // ======================================
