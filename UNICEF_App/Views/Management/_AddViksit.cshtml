<script nonce="@nonce">

    document.addEventListener('DOMContentLoaded', function () {

        const themeDropdown =
            document.getElementById('Themes');

        const subThemeDropdown =
            document.getElementById('SubThemes');

        const btnAdd =
            document.getElementById('btnAddPillarMapping');

        const container =
            document.getElementById('pillarMappingContainer');

        const hiddenInput =
            document.getElementById('pillarJsonData');

        const badge =
            document.getElementById('pillarCountBadge');

        // =========================================
        // STORE DATA
        // =========================================

        //let themeData = {};

        // =========================================
        // ADD LOGIC
        // =========================================

        btnAdd.addEventListener('click', function () {

            const tId =
                themeDropdown.value;

            const tName =
                themeDropdown.options[
                    themeDropdown.selectedIndex
                ].text;

            const stId =
                subThemeDropdown.value;

            const stName =
                subThemeDropdown.options[
                    subThemeDropdown.selectedIndex
                ].text;

            // Validation
            if (!tId || !stId) {

                alert("Themes aur SubThemes select karein.");

                return;
            }

            // Theme Create
            if (!themeData[tId]) {

                themeData[tId] = {

                    name: tName,

                    subThemes: []
                };
            }

            // Duplicate Check
            const exists =
                themeData[tId]
                    .subThemes
                    .some(x => x.id == stId);

            if (exists) {

                alert("Yeh SubTheme pehle se add hai.");

                return;
            }

            // Add SubTheme
            themeData[tId].subThemes.push({

                id: stId,

                name: stName
            });

            renderUI();

            subThemeDropdown.value = "";
        });

        // =========================================
        // RENDER UI
        // =========================================

        function renderUI() {

            const themeIds =
                Object.keys(themeData);

            // Empty State
            if (themeIds.length === 0) {

                container.innerHTML = `
                    <div class="empty-mapping">

                        <i class="fas fa-columns fa-3x mb-3"></i>

                        <p>
                            No Themes mapped yet.
                        </p>

                    </div>
                `;

                badge.textContent =
                    "0 SubThemes Mapped";

                hiddenInput.value = "";

                return;
            }

            container.innerHTML = '';

            let total = 0;

            // Loop Themes
            themeIds.forEach(tId => {

                const theme =
                    themeData[tId];

                let subThemeHtml = '';

                // Loop SubThemes
                theme.subThemes.forEach((st, idx) => {

                    total++;

                    subThemeHtml += `

                        <div class="subsector-entry">

                            <span class="subsector-name">

                                ${st.name}

                            </span>

                            <button
                                class="btn-remove-sub"
                                data-t="${tId}"
                                data-idx="${idx}">

                                <i class="bx bx-trash"></i>

                            </button>

                        </div>
                    `;
                });

                // Theme Card
                const card = `

                    <div class="pillar-card mb-3">

                        <div class="pillar-group-header">

                            <span>

                                ${theme.name}

                            </span>

                            <button
                                class="btn btn-danger btn-sm btn-remove-theme"
                                data-t="${tId}">

                                <i class="bx bx-trash"></i>

                            </button>

                        </div>

                        <div class="sector-block">

                            <div class="sector-title">

                                SubThemes

                            </div>

                            ${subThemeHtml}

                        </div>

                    </div>
                `;

                container.innerHTML += card;
            });

            badge.textContent =
                `${total} SubThemes Mapped`;

            hiddenInput.value =
                JSON.stringify(themeData);
        }

        // =========================================
        // REMOVE LOGIC
        // =========================================

        container.addEventListener('click', function (e) {

            // Remove SubTheme
            const subBtn =
                e.target.closest('.btn-remove-sub');

            if (subBtn) {

                const tId =
                    subBtn.dataset.t;

                const idx =
                    subBtn.dataset.idx;

                themeData[tId]
                    .subThemes
                    .splice(idx, 1);

                // Remove Empty Theme
                if (themeData[tId]
                    .subThemes.length === 0) {

                    delete themeData[tId];
                }

                renderUI();

                return;
            }

            // Remove Full Theme
            const themeBtn =
                e.target.closest('.btn-remove-theme');

            if (themeBtn) {

                const tId =
                    themeBtn.dataset.t;

                if (confirm("Pura Theme delete karna hai?")) {

                    delete themeData[tId];

                    renderUI();
                }
            }
        });

    });

</script>