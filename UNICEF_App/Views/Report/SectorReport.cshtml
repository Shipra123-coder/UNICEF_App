    /* SUMMARY CARDS DESIGN MATCHING SCREENSHOT */
    .summary-card-container {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: #ffffff;
        border: 1px solid #e8eef5;
        border-radius: 14px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.03);
        flex: 1 1 calc(20% - 12px);
        min-width: 170px;
        box-sizing: border-box;
    }

        /* TOP-RIGHT CORNER PASTEL CIRCLE ACCENTS */
        .summary-card::after, .summary-card-wide::after {
            content: '';
            position: absolute;
            top: -15px;
            right: -15px;
            width: 45px;
            height: 45px;
            border-radius: 50%;
        }

    .card-blue::after {
        background-color: #e0f2fe;
    }

    .card-green::after {
        background-color: #dcfce7;
    }

    .card-yellow::after {
        background-color: #fef3c7;
    }

    .card-red::after {
        background-color: #fee2e2;
    }

    .card-purple::after {
        background-color: #f3e8ff;
    }

    /* ICON STYLING */
    .summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-right: 12px;
        color: #fff;
        flex-shrink: 0;
    }

    .bg-icon-blue {
        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
    }

    .bg-icon-yellow {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    .bg-icon-colorful {
        background: linear-gradient(135deg, #3b82f6, #0284c7);
    }

    .summary-data {
        display: flex;
        flex-direction: flex-start;
    }

    .summary-value {
        font-size: 20px;
        font-weight: 800;
        color: #1e293b;
        line-height: 1;
        display: inline-block;
        margin-right: 6px;
    }

    .summary-label {
        font-size: 13px;
        font-weight: 700;
        color: #475569;
        margin-top: 2px;
    }

    /* GROUPED WIDE CARDS */
    .summary-card-wide {
        background: #ffffff;
        border: 1px solid #e8eef5;
        border-radius: 14px;
        padding: 12px 16px 8px 16px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.03);
        flex: 1 1 calc(50% - 10px);
        min-width: 320px;
        box-sizing: border-box;
    }

    .group-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-around;
    }

    .group-item {
        display: flex;
        align-items: center;
    }

    .group-divider {
        width: 1px;
        height: 28px;
        background-color: #e2e8f0;
    }

    .group-footer-title {
        text-align: center;
        font-weight: 800;
        font-size: 13px;
        color: #2563eb;
        margin-top: 6px;
    }

    /* Section Headers */
    .department {
        background: #0b5ed7;
        color: #fff;
        padding: 12px;
        font-size: 20px;
        font-weight: bold;
        margin-top: 20px;
    }

    .sector {
        background: #dbeafe;
        padding: 10px 15px;
        font-size: 17px;
        font-weight: bold;
        border-left: 6px solid #0b5ed7;
        margin-top: 5px;
    }

    .agency {
        background: #e8f5e9;
        padding: 10px 15px;
        font-size: 16px;
        font-weight: 600;
        border-left: 6px solid #2e7d32;
        margin-top: 5px;
    }

    /* ACTIVITY BLOCK WITH METADATA TABLE */
    .activity-container {
        margin-top: 15px;
        margin-bottom: 20px;
        border: 1px solid #fcd34d;
        border-radius: 6px;
        overflow: hidden;
        background: #fff;
    }

    .activity-title-header {
        background: #fff8e1;
        padding: 10px 15px;
        font-size: 16px;
        font-weight: bold;
        color: #856404;
        border-left: 6px solid #f9a825;
        border-bottom: 1px solid #ffeeba;
    }

    .activity-meta-table {
        width: 100%;
        margin-bottom: 0 !important;
        font-size: 13px;
        background-color: #fffdf5;
    }

        .activity-meta-table th {
            background-color: #fef3c7 !important;
            color: #78350f !important;
            font-weight: 700;
            text-align: left !important;
            border-color: #fde68a !important;
        }

        .activity-meta-table td {
            border-color: #fde68a !important;
            color: #334155;
        }

    /* Badges */
    .badge-agency {
        background-color: #0284c7;
        color: #fff;
        padding: 2px 7px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge-sdg {
        background-color: #15803d;
        color: #fff;
        padding: 2px 7px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge-target {
        background-color: #0369a1;
        color: #fff;
        padding: 2px 7px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge-vr-theme {
        background-color: #4338ca;
        color: #fff;
        padding: 2px 7px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
    }

    .badge-vr-subtheme {
        background-color: #6b21a8;
        color: #fff;
        padding: 2px 7px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
    }

    /* Tasks Table */
    .task-table {
        margin-top: 0px !important;
    }

        .task-table th {
            background: #334155 !important;
            color: #fff !important;
            text-align: center;
            font-size: 13px;
        }

    .completed {
        color: #16a34a;
        font-weight: bold;
    }

    .progress {
        color: #d97706;
        font-weight: bold;
        line-height: 0rem !important;
    }

    .pending {
        color: #dc2626;
        font-weight: bold;
    }

    .summary-title {
        margin-top: 25px;
        background: #0b5ed7;
        color: #fff;
        padding: 10px;
        font-size: 18px;
        font-weight: bold;
    }

    .footer {
        margin-top: 30px;
        border-top: 1px solid #ccc;
        padding-top: 10px;
        display: flex;
        justify-content: space-between;
    }
</style>
<style nonce="${nonce || ''}">
    @@page {
        size: auto;
        margin: 0 !important; /* Direct root level margin: 0 browser default header/footer (about:blank & 1/2) ko hide kar deta hai */
    }

    /* GENERAL RESET FOR COMPACT PRINT */
    * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        box-sizing: border-box !important;
    }

    html, body {
        background: #fff !important;
        font-family: Calibri, Arial, sans-serif !important;
        font-size: 11px !important;
        margin: 0 !important;
        padding: 8mm 10mm 15mm 10mm !important; /* Content aur paper border ke beech space */
        color: #1e293b !important;
    }

    .report {
        width: 100% !important;
        margin: 0 !important;
        background: #fff !important;
        padding: 0 !important;
        border: none !important;
    }

    /* ... Baaki saari existing CSS (summary cards, tables, headers) yahan rahegi ... */

    /* 🌟 2. FOOTER & PRINT MEDIA STYLING */
    .footer {
        border-top: 1px solid #cbd5e1 !important;
        padding-top: 4px !important;
        display: flex !important;
        justify-content: space-between !important;
        font-size: 10px !important;
        background: #fff !important;
    }

    @@media print {
        /* Custom Footer ko har page ke bottom me fix rakhne ke liye */
        .footer {
            position: fixed !important;
            bottom: 5mm !important;
            left: 10mm !important;
            right: 10mm !important;
            width: auto !important;
        }

        .footer-right::after {
            content: counter(page);
        }
    }
</style>

