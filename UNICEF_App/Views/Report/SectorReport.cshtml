                    <div class="col">Delayed: <span id="lblSummaryDelayed" class="text-danger">0</span></div>
                    <div class="col">Not Started: <span id="lblSummaryNotStarted" class="text-secondary">0</span></div>
                </div>
            </div>
        </div>

        <!-- DYNAMIC CONTENT RENDER CONTAINER -->
        <div id="activityReportContainer">
            <div class="text-center my-4 text-muted">
                <p class="mb-0">Please select a Sector and click "Load Report" to view details.</p>
            </div>
        </div>

    </div>
</div>

<script nonce="@nonce" src="~/custom/Common.js"></script>
<script nonce="@nonce" src="~/custom/PrintSector.js" asp-append-version="true"></script>
<script nonce="@nonce">
    document.addEventListener('DOMContentLoaded', function () {

        // 1. Safe Vanilla JS to get hiddenSectorId value
        var hiddenSectorElem = document.getElementById('hiddenSectorId');
        var hiddenSectorVal = hiddenSectorElem ? hiddenSectorElem.value : '';

        // Dropdown Bind
        if (typeof common !== 'undefined' && common.BindDropdown) {
            common.BindDropdown(`/Master/DDL_UNSector`, "Sector", "Sector", hiddenSectorVal);
        }

        // Filter Button Click Listener
        var btnLoad = document.getElementById('btnLoadReport');
        if (btnLoad) {
            btnLoad.addEventListener('click', function () {
                var SectorElem = document.getElementById('Sector');
                var SectorId = SectorElem ? SectorElem.value : '';

                if (SectorId && SectorId !== "-1") {
                    // 🌟 Bootstrap 'd-none' class ko remove karein taaki container dikhe
                    var printDiv = document.getElementById('printDiv');
                    if (printDiv) {
                        printDiv.classList.remove('d-none');
                    }

                    if (typeof printSectorReport !== 'undefined') {
                        printSectorReport.loadSectorWiseData(SectorId);
                    }
                } else {
                    alert("Please select a sector!");
                }
            });
        }

        // Auto Load if ViewBag.SectorId exists
        //if ('@ViewBag.SectorId' !== '' && '@ViewBag.SectorId' !== '-1') {
            //setTimeout(() => {
            //    var printDiv = document.getElementById('printDiv');
            //    if (printDiv) {
            //        printDiv.classList.remove('d-none'); // 🌟 Unhide
            //    }
            //    if (typeof printSectorReport !== 'undefined') {
            //        printSectorReport.loadSectorWiseData(hiddenSectorVal);
            //    }
            //}, 500);
        //}

        // 3. Print Report Button Event Listener
        var btnPrint = document.getElementById('btnPrintReport');
        if (btnPrint) {
            btnPrint.addEventListener('click', function () {
                if (typeof printSectorReport !== 'undefined') {
                    printSectorReport.printDiv('@nonce');
                }
            });
        }
    });
</script>