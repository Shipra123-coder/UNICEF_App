    /* SUMMARY CARDS DESIGN MATCHING SCREENSHOT */
    .summary-card-container {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: #ffffff;
        border: 1px solid #e8eef5;
        border-radius: 14px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.03);
        flex: 1 1 calc(20% - 12px);
        min-width: 170px;
        box-sizing: border-box;
    }

        /* TOP-RIGHT CORNER PASTEL CIRCLE ACCENTS */
        .summary-card::after, .summary-card-wide::after {
            content: '';
            position: absolute;
            top: -15px;
            right: -15px;
            width: 45px;
            height: 45px;
            border-radius: 50%;
        }

    .card-blue::after {
        background-color: #e0f2fe;
    }

    .card-green::after {
        background-color: #dcfce7;
    }

    .card-yellow::after {
        background-color: #fef3c7;
    }

    .card-red::after {
        background-color: #fee2e2;
    }

    .card-purple::after {
        background-color: #f3e8ff;
    }

    /* ICON STYLING */
    .summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-right: 12px;
        color: #fff;
        flex-shrink: 0;
    }

    .bg-icon-blue {
        background: linear-gradient(135deg, #0d6efd, #0b5ed7);
    }

    .bg-icon-yellow {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    .bg-icon-colorful {
        background: linear-gradient(135deg, #3b82f6, #0284c7);
    }

    .summary-data {
        display: flex;
        flex-direction: flex-start;
    }

    .summary-value {
        font-size: 20px;
        font-weight: 800;
        color: #1e293b;
        line-height: 1;
        display: inline-block;
        margin-right: 6px;
    }

    .summary-label {
        font-size: 13px;
        font-weight: 700;
        color: #475569;
        margin-top: 2px;
    }

    /* GROUPED WIDE CARDS */
    .summary-card-wide {
        background: #ffffff;
        border: 1px solid #e8eef5;
        border-radius: 14px;
        padding: 12px 16px 8px 16px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.03);
        flex: 1 1 calc(50% - 10px);
        min-width: 320px;
        box-sizing: border-box;
    }

    .group-wrapper {
        display: flex;
        align-items: center;
        justify-content: space-around;
    }

    .group-item {
        display: flex;
        align-items: center;
    }

    .group-divider {
        width: 1px;
        height: 28px;
        background-color: #e2e8f0;
    }

    .group-footer-title {
        text-align: center;
        font-weight: 800;
        font-size: 13px;
        color: #2563eb;
        margin-top: 6px;
    }

    /* Section Headers */
    .department {
