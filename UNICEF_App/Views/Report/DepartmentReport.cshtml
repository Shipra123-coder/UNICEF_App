        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
    }

    /* Tasks Table */
    .task-table {
        margin-top: 0px !important;
    }

        .task-table th {
            background: #334155 !important;
            color: #fff !important;
            text-align: center;
            font-size: 13px;
        }

    .completed {
        color: #16a34a;
        font-weight: bold;
    }

    .progress {
        color: #d97706;
        font-weight: bold;
        line-height: 0rem !important;
    }

    .pending {
        color: #dc2626;
        font-weight: bold;
    }

    .summary-title {
        margin-top: 25px;
        background: #0b5ed7;
        color: #fff;
        padding: 10px;
        font-size: 18px;
        font-weight: bold;
    }

    .footer {
        margin-top: 30px;
        border-top: 1px solid #ccc;
        padding-top: 10px;
        display: flex;
        justify-content: space-between;
    }
</style>
<style nonce="${nonce || ''}">
    @@page {
        size: auto;
        margin: 0 !important; /* Direct root level margin: 0 browser default header/footer (about:blank & 1/2) ko hide kar deta hai */
    }

    /* GENERAL RESET FOR COMPACT PRINT */
    * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        box-sizing: border-box !important;
    }

    html, body {
        background: #fff !important;
        font-family: Calibri, Arial, sans-serif !important;
        font-size: 11px !important;
        margin: 0 !important;
        padding: 8mm 10mm 15mm 10mm !important; /* Content aur paper border ke beech space */
        color: #1e293b !important;
    }

    .report {
        width: 100% !important;
        margin: 0 !important;
        background: #fff !important;
        padding: 0 !important;
        border: none !important;
    }

    /* ... Baaki saari existing CSS (summary cards, tables, headers) yahan rahegi ... */

    /* 🌟 2. FOOTER & PRINT MEDIA STYLING */
    .footer {
        border-top: 1px solid #cbd5e1 !important;
        padding-top: 4px !important;
        display: flex !important;
        justify-content: space-between !important;
        font-size: 10px !important;
        background: #fff !important;
    }

    @@media print {
        /* Custom Footer ko har page ke bottom me fix rakhne ke liye */
        .footer {
            position: fixed !important;
            bottom: 5mm !important;
            left: 10mm !important;
            right: 10mm !important;
            width: auto !important;
        }

        .footer-right::after {
            content: counter(page);
        }
    }
</style>
