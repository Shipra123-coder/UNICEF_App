        <script nonce="@nonce">
    document.addEventListener('DOMContentLoaded', function () {

        // 1. Safe Vanilla JS to get hiddenDeptId value
        var hiddenDeptElem = document.getElementById('hiddenDeptId');
        var hiddenDeptVal = hiddenDeptElem ? hiddenDeptElem.value : '';

        // Dropdown Bind
        if (typeof common !== 'undefined' && common.BindDropdown) {
            common.BindDropdown(`/Master/DDL_Department`, "Department", "Department", hiddenDeptVal);
        }

        // Filter Button Click Listener
        var btnLoad = document.getElementById('btnLoadReport');
        if (btnLoad) {
            btnLoad.addEventListener('click', function () {
                var deptElem = document.getElementById('Department');
                var deptId = deptElem ? deptElem.value : '';

                if (deptId && deptId !== "-1") {
                    // 🌟 Bootstrap 'd-none' class ko remove karein taaki container dikhe
                    var printDiv = document.getElementById('printDiv');
                    if (printDiv) {
                        printDiv.classList.remove('d-none');
                    }

                    if (typeof printDepartmentReport !== 'undefined') {
                        printDepartmentReport.loadDepartmentWiseData(deptId);
                    }
                } else {
                    alert("Please select a department!");
                }
            });
        }

        // Auto Load if ViewBag.DeptId exists
        if ('@ViewBag.DeptId' !== '' && '@ViewBag.DeptId' !== '-1') {
            setTimeout(() => {
                var printDiv = document.getElementById('printDiv');
                if (printDiv) {
                    printDiv.classList.remove('d-none'); // 🌟 Unhide
                }
                if (typeof printDepartmentReport !== 'undefined') {
                    printDepartmentReport.loadDepartmentWiseData(hiddenDeptVal);
                }
            }, 500);
        }

        // 3. Print Report Button Event Listener
        var btnPrint = document.getElementById('btnPrintReport');
        if (btnPrint) {
            btnPrint.addEventListener('click', function () {
                if (typeof printDepartmentReport !== 'undefined') {
                    printDepartmentReport.printDiv('@nonce');
                }
            });
        }
    });
        </script>
