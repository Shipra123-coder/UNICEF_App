<style nonce="@nonce">
    .margin-top-new{
        margin-top:240px;
    }
    .contact-card,
    .agency-card {
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,.08);
        overflow: hidden;
        transition: .3s;
        height: 100%;
    }

        .contact-card:hover,
        .agency-card:hover {
            transform: translateY(-5px);
        }

    .contact-header {
        background: linear-gradient(135deg,#2563eb,#1d4ed8);
        color: #fff;
        padding: 14px 20px;
        font-weight: 600;
    }

    .contact-body {
        padding: 20px;
    }

    .agency-card {
        text-align: center;
        padding: 25px;
    }

    .agency-logo {
        width: 90px;
        height: 90px;
        object-fit: contain;
        margin-bottom: 15px;
    }

    .nav-pills .nav-link {
        border-radius: 30px;
        padding: 10px 25px;
        font-weight: 600;
    }

        .nav-pills .nav-link.active {
            background: #2563eb;
        }

    .table thead {
        background: #f1f5f9;
    }
</style>
