@{
    ViewData["Title"] = "SDGs Page";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<style nonce="@nonce">
    .sector-banner {
        margin-top: 200px;
        padding: 20px;
    }

    /* Modern Responsive Grid System */
    .goals-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 20px;
        justify-items: center;
        max-width: 1200px;
        margin: 0 auto;
    }

    /* Flip Box Outer Wrapper */
    .flip-box {
        background-color: transparent;
        width: 130px;
        height: 130px;
        perspective: 1000px; /* 3D effect enable karta hai */
    }

    /* Link & Inner Card Container */
    .flip-box-inner {
        display: block; /* MUST HAVE: <a> tag ko block element banane ke liye */
        position: relative;
        width: 100%;
        height: 100%;
        text-align: center;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        transform-style: preserve-3d; /* Both sides ko 3D space mein rakhta hai */
        border-radius: 8px;
        text-decoration: none;
    }

    /* Hover State Rotation */
    .flip-box:hover .flip-box-inner {
        transform: rotateY(180deg);
    }

    /* Front & Back Card Layers */
    .flip-box-front,
    .flip-box-back {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden; /* Opposite side chhipane ke liye */
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    }

    .flip-box-front {
        background-color: #ffffff;
    }

    .flip-box-back {
        background-color: #007bff;
        transform: rotateY(180deg); /* Back side ko Pehle se 180deg flip rakhta hai */
    }

    /* Image Sizing Fix */
    .flip-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>

