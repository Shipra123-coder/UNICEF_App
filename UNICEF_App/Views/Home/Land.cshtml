<!-- BAR GRAPH SCRIPT -->
<script nonce="@nonce">
    document.addEventListener("DOMContentLoaded", function () {

        dashboard.loadChartAgency();
        dashboard.loadChartDepartment();

        dashboard.loadActivityStatusChart();
        dashboard.loadChartTask();


        // एलिमेंट्स से वैल्यू निकालने का शुद्ध जावास्क्रिप्ट तरीका
        const unsectorEl = document.getElementById('hiddenunsector');
        const agencysEl = document.getElementById('hiddenagencys');
        const departmentEl = document.getElementById('hiddendepartment');

        const unsectorVal = unsectorEl ? unsectorEl.value : "";
        const agencysVal = agencysEl ? agencysEl.value : "";
        const departmentVal = departmentEl ? departmentEl.value : "";

        // ड्रॉपडाउन बाइंड करना
        if (typeof common !== "undefined" && typeof common.BindDropdown === "function") {
            common.BindDropdown("/Master/DDL_UNSector", "UNSector", "All", unsectorVal);
            common.BindDropdown("/Master/DDL_Agency", "Agencys", "All", agencysVal);
            common.BindDropdown("/Master/DDL_Department", "Department", "All", departmentVal);
        }

        // डैशबोर्ड फंक्शन्स लोड करना
        if (typeof dashboard !== "undefined") {
            if (typeof dashboard.loadCoverPages === "function") dashboard.loadCoverPages();
            if (typeof dashboard.loadDashboardCounts === "function") dashboard.loadDashboardCounts();
            if (typeof dashboard.loadAgencyList === "function") dashboard.loadAgencyList();
            if (typeof dashboard.loadChartGoal === "function") dashboard.loadChartGoal();
        }

        // =======================================================
        // DROPDOWN CHANGE EVENTS (UNSector, Agencys, Department)
        // =======================================================
        // इन तीनों ड्रॉपडाउन आईडी को एक एरे में रखकर सीधे इवेंट लिस्टनर जोड़ना
        const dropdownIds = ["UNSector", "Agencys", "Department"];

        dropdownIds.forEach(function (id) {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener("change", function () {
                    if (typeof dashboard !== "undefined" && typeof dashboard.loadDashboardCounts === "function") {
                        dashboard.loadDashboardCounts();
                    }
                });
            }
        });

    });
</script>

