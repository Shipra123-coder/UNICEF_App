    /* RESPONSIVE */

    @@media(max-width:1200px) {

        .sector-wheel {
            width: 450px;
            height: 450px;
            margin-top: 40px;
        }

        .heading {
            font-size: 38px;
        }
    }

    @@media(max-width:991px) {

        .dashboard-section {
