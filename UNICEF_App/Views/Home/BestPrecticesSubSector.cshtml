    }

    .t2 {
        top: 140px;
        right: 40px;
    }

    .t3 {
        top: 270px;
        right: 0px;
    }

    .t4 {
        bottom: 120px;
        right: 60px;
    }

    .t5 {
        bottom: 40px;
        left: 240px;
    }

    .t6 {
        bottom: 120px;
        left: 60px;
    }

    .t7 {
        top: 280px;
        left: -10px;
    }

    .t8 {
        top: 130px;
