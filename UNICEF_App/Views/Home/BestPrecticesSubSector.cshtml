<style nonce="@nonce">

    /*body {
        margin: 0;
        font-family: 'Segoe UI',sans-serif;
        background: #eef3ff;
        overflow-x: hidden;
    }*/

    /* MAIN SECTION */

    .dashboard-section {
        padding: 50px 60px;
        position: relative;
    }

        .dashboard-section::before {
            content: '';
            position: absolute;
            width: 700px;
            height: 700px;
            background: linear-gradient(135deg,#dbeafe,#eff6ff);
            border-radius: 50%;
            top: -300px;
            right: -250px;
            z-index: -1;
        }

    .left-content {
        position: relative;
        z-index: 2;
    }

    .heading {
        font-size: 48px;
        font-weight: 800;
        color: #082f75;
        line-height: 1.2;
    }

        .heading span {
            color: #0ea5e9;
        }

    .subheading {
        font-size: 18px;
        color: #5b6475;
        margin-top: 12px;
        margin-bottom: 35px;
    }

    /* FILTERS */

    .filter-wrapper {
        display: flex;
        gap: 18px;
        margin-bottom: 35px;
    }

    .filter-card {
        background: #fff;
        border-radius: 18px;
        padding: 14px 18px;
        width: 260px;
        box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        border: 1px solid #dbe4ff;
    }

        .filter-card label {
            display: block;
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            margin-bottom: 5px;
        }

        .filter-card select {
            width: 100%;
            border: none;
            outline: none;
            background: none;
            color: #0f172a;
            font-weight: 700;
            font-size: 16px;
        }

    /* INFO BOX */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 20px;
        max-width: 600px;
    }

    .info-box {
        position: relative;
        background: #fff;
        border-radius: 22px;
        padding: 25px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
        transition: 0.3s;
        border: 1px solid #dce6ff;
    }

        .info-box:hover {
            transform: translateY(-6px);
        }

        .info-box::before {
            content: '';
            position: absolute;
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg,#dbeafe,#eff6ff);
            border-radius: 50%;
            top: -50px;
            right: -40px;
        }

    .box-title {
        font-size: 13px;
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .box-count {
        font-size: 54px;
        font-weight: 800;
        color: #082f75;
        line-height: 1;
        margin-top: 12px;
    }

    .box-text {
        font-size: 18px;
        font-weight: 600;
        color: #334155;
        margin-top: 10px;
    }

    .box-icon {
        position: absolute;
        bottom: 20px;
        right: 20px;
        width: 42px;
        height: 42px;
        border-radius: 14px;
        background: #0ea5e9;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    /* RIGHT SIDE */

    .sector-panel {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sector-wheel {
        width: 580px;
        height: 580px;
        position: relative;
        border-radius: 50%;
        background: #fff;
        box-shadow: 0 20px 50px rgba(0,0,0,0.08);
        padding: 20px;
    }

    .wheel {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: conic-gradient( #14b8a6 0deg 45deg, #0f766e 45deg 90deg, #9333ea 90deg 135deg, #ec4899 135deg 180deg, #f97316 180deg 225deg, #eab308 225deg 270deg, #22c55e 270deg 315deg, #3b82f6 315deg 360deg );
        position: relative;
    }

        .wheel::before {
            content: '';
            position: absolute;
            width: 220px;
            height: 220px;
            background: #fff;
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%);
            box-shadow: 0 0 20px rgba(0,0,0,0.08);
        }

    .center-circle {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
