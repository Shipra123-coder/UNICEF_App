@{
    ViewData["Title"] = "AboutUs Page";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<!-- ========================================= -->
<!-- ABOUT US SECTION -->
<!-- ========================================= -->

<section class="about-page margin-top-new">

    <!-- HERO SECTION -->

    <div class="about-hero mt-4">
        <div class="container">
            <div class="hero-content">
                @* <span class="about-badge">
                    Government – UN Strategic Partnership Platform
                </span> *@
                <h1 class="about-title">
                    About Us
                </h1>
                <p class="about-subtitle">
                    Strengthening partnerships, convergence and evidence-based
                    development planning across Rajasthan.
                </p>
            </div>
        </div>
    </div>

    <!-- CONTENT SECTION -->

    <div class="container">

        <div class="about-wrapper">

            <div class="row align-items-start g-5">

                <!-- LEFT CONTENT -->

                <div class="col-lg-8">

                    <div class="content-card">

                        <div class="section-heading">

                            <span class="heading-line"></span>

                            <h2>
                                Program Cooperation and Strategic Partnership Platform
                            </h2>

                        </div>

                        <p>
                            The United Nations system has been a longstanding and trusted partner to the
                            Government of India and State Governments, supporting inclusive, equitable
                            and sustainable development across sectors. In Rajasthan, the State government
                            has maintained a mature and constructive engagement with multiple United
                            Nations agencies across key sectors including health, nutrition, education, child
                            protection, water and sanitation, skill, adolescent & youth empowerment,
                            climate resilience, social protection and public finance.
                        </p>

                        <p>
                            Most of the engagements between the line departments and the UN agencies
                            were bilateral and sector-specific. The cumulative contribution of the UN
                            system across sectors and geographies was not consolidated in a unified
                            framework. Upstream reforms, digital system strengthening, public finance
                            advisory, policy support and innovations were often operated within
                            departmental silos. There were Multi-dimensional challenges such as
                            malnutrition, adolescent development, climate vulnerability, disability inclusion
                            and social protection coverage, which require stronger cross-sector alignment
                            and structured policy dialogue.
                        </p>

                        <p>
                            Considering the problems and challenges faced in reporting, reviewing and for
                            evidence-based policy planning, the Government of Rajasthan decided to
                            develop an integrated Dashboard/Platform to enhance coherence and
                            convergence of government–UN collaboration.
                        </p>

                        <p>
                            This ‘Program Cooperation and Strategic Partnership Platform’ is developed as
                            an initiative by the SDGs Coordination & Acceleration Centre (SDGCAC) in
                            Directorate of Economics & Statistics in collaboration the UNICEF. This
                            Dashboard is an example of the spirit and targets of SDG 17 (Partnerships for
                            the Goals). This platform intended as a review, monitoring or regulatory
                            mechanism. Rather, it is also envisioned as a facilitative and strategic
                            partnership architecture.
                        </p>

                        <p>
                            This Platform seeks to institutionalize a structured, State government-led
                            process for documenting, aligning and leveraging all UN-supported
                            engagements in the State. The emphasis is on strengthening systems and
                            enhancing policy coherence rather than duplicating monitoring functions.
                        </p>

                        <!-- OBJECTIVES -->

                        <div class="info-box">

                            <h3>
                                Presently, major activities are being covered by this platform:
                            </h3>

                            <ul class="custom-list">

                                <li>
                                    Align UN-supported engagements with SDGs targets and
                                    Viksit Rajasthan@2047 priorities.
                                </li>

                                <li>
                                    Provide a consolidated view of cumulative UN-supported engagements.
                                </li>

                                <li>
                                    Promote convergence across departments for multi-sectoral challenges.
                                </li>

                                <li>
                                    Position Rajasthan as a national exemplar of upstream and catalytic
                                    State Government – UN system cooperation.
                                </li>

                            </ul>

                        </div>

                        <!-- ACTIVITIES -->

                        <div class="info-box mt-4">

                            <h3>
                                This platform is anchored by SDGs Coordination & Acceleration Centre within
                                the Directorate of Economics and Statistics. It is conducting following
                                activities:
                            </h3>

                            <ul class="custom-list">

                                <li>
                                    Maintain a consolidated digital repository of Government–UN engagements.
                                </li>

                                <li>
                                    Map interventions against SDGs goals and targets.
                                </li>

                                <li>
                                    Generate analytical briefs identifying convergence opportunities and
                                    scalable innovations.
                                </li>

                            </ul>

                        </div>

                        <!-- FINAL NOTE -->

                        <div class="highlight-box">

                            <p>

                                This Portal is enhancing transparency, ensure uniformity in reporting and
                                significantly reduce the need for ad-hoc information requests from departments
                                and development partners.

                            </p>

                        </div>

                    </div>

                </div>

                <!-- RIGHT SIDE -->

                <div class="col-lg-4">

                    <div class="side-card">

                        <img src="/public/img/homepage/sector_wheel/image_3_grad.png"
                             class="side-img">

                        <div class="side-content">

                            <h3 class="color-white">
                                SDG 17
                            </h3>

                            <p class="color-white">
                                Partnerships for the Goals
                            </p>

                        </div>

                    </div>

                    <div class="stats-card">

                        <div class="stats-item">

                            <h4>
                                10+
                            </h4>

                            <span>
                                Key Sectors
                            </span>

                        </div>

                        <div class="stats-item">

                            <h4>
                                UN
                            </h4>

                            <span>
                                Strategic Partnership
                            </span>

                        </div>

                        <div class="stats-item">

                            <h4>
                                SDGs
                            </h4>

                            <span>
                                Target Alignment
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- ========================================= -->
<!-- CSS -->
<!-- ========================================= -->

<style nonce="@nonce">
    .margin-top-new {
        margin-top: 166px;
    }
    .color-white {
        color: #fff;
    }
    .about-page {        
        overflow: hidden;
    }
    /* ===================================== */
    /* HERO */
    /* ===================================== */

    .about-hero {
        background: linear-gradient( 135deg, rgba(13,71,161,0.95), rgba(38,198,218,0.90) ), url('/public/img/homepage/sector_wheel/image_1_grad.png');
        background-size: cover;
        background-position: center;
        padding-top: 30px;
        padding-bottom: 30px;
        position: relative;
    }

    .hero-content {
        max-width: 850px;
    }

    .about-badge {
        display: inline-block;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.25);
        color: #fff;
        padding: 10px 18px;
        border-radius: 40px;
        font-size: 14px;
        margin-bottom: 25px;
        backdrop-filter: blur(8px);
    }

    .about-title {
        font-size: 64px;
        font-weight: 800;
        color: #fff;
        margin-bottom: 20px;
    }

    .about-subtitle {
        font-size: 20px;
        line-height: 1.8;
        color: rgba(255,255,255,0.9);
        max-width: 700px;
    }

    /* ===================================== */
    /* WRAPPER */
    /* ===================================== */

    .about-wrapper {
        margin-top: -60px;
        margin-bottom: 70px;
        position: relative;
        z-index: 5;
    }

    .content-card {
        background: #fff;
        border-radius: 28px;
        padding: 50px;
        box-shadow: 0 10px 35px rgba(0,0,0,0.08);
    }

    /* ===================================== */
    /* HEADINGS */
    /* ===================================== */

    .section-heading {
        display: flex;
        align-items: center;
        margin-bottom: 35px;
    }

    .heading-line {
        width: 70px;
        height: 5px;
        background: #0d47a1;
        border-radius: 20px;
        margin-right: 18px;
    }

    .section-heading h2 {
        font-size: 34px;
        font-weight: 700;
        color: #0d1b2a;
        margin: 0;
    }

    /* ===================================== */
    /* PARAGRAPH */
    /* ===================================== */

    .content-card p {
        font-size: 17px;
        line-height: 2;
        color: #4d5b6b;
        margin-bottom: 28px;
        text-align: justify;
    }

    /* ===================================== */
    /* INFO BOX */
    /* ===================================== */

    .info-box {
        background: #f8fbff;
        border-left: 5px solid #0d47a1;
        padding: 30px;
        border-radius: 18px;
    }

        .info-box h3 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 20px;
            color: #0d1b2a;
        }

    .custom-list {
        padding-left: 20px;
        margin: 0;
    }

        .custom-list li {
            font-size: 16px;
            line-height: 1.9;
            color: #4d5b6b;
            margin-bottom: 12px;
        }

    /* ===================================== */
    /* HIGHLIGHT */
    /* ===================================== */

    .highlight-box {
        background: linear-gradient( 135deg, #0d47a1, #26c6da );
        padding: 35px;
        border-radius: 22px;
        margin-top: 35px;
    }

        .highlight-box p {
            color: #fff;
            margin: 0;
            font-size: 18px;
            line-height: 1.9;
        }

    /* ===================================== */
    /* RIGHT SIDE */
    /* ===================================== */

    .side-card {
        position: relative;
        border-radius: 25px;
        overflow: hidden;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.10);
    }

    .side-img {
        width: 100%;
        height: 350px;
        object-fit: cover;
    }

    .side-card::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient( rgba(0,0,0,0.2), rgba(0,0,0,0.7) );
    }

    .side-content {
        position: absolute;
        bottom: 30px;
        left: 30px;
        z-index: 5;
        color: #fff;
    }

        .side-content h3 {
            font-size: 42px;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .side-content p {
            font-size: 18px;
            margin: 0;
        }

    /* ===================================== */
    /* STATS */
    /* ===================================== */

    .stats-card {
        background: #fff;
        border-radius: 25px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .stats-item {
        text-align: center;
        padding: 22px 0;
        border-bottom: 1px solid #edf1f5;
    }

        .stats-item:last-child {
            border-bottom: none;
        }

        .stats-item h4 {
            font-size: 42px;
            font-weight: 800;
            color: #0d47a1;
            margin-bottom: 10px;
        }

        .stats-item span {
            font-size: 16px;
            color: #5c6b7a;
        }

    /* ===================================== */
    /* RESPONSIVE */
    /* ===================================== */

    @@media(max-width:991px) {

        .about-title {
            font-size: 44px;
        }

        .content-card {
            padding: 30px;
        }

        .section-heading h2 {
            font-size: 28px;
        }
    }

    @@media(max-width:576px) {

        .about-title {
            font-size: 36px;
        }

        .about-subtitle {
            font-size: 16px;
        }

        .content-card {
            padding: 25px;
        }

        .highlight-box {
            padding: 25px;
        }
    }

</style>