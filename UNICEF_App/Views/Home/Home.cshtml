<style nonce="@nonce">
    /* --- General Reset --- */
    /* * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f9f9f9;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        } */

    /* --- Main Containers --- */
    .main-container {
        width: 100%;
        /* max-width: 1200px; */
        text-align: center;
    }

    .main-title {
        color: #f15a24; /* Orange color from image */
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .infographic-border {
        border: 2px solid #ffcccc; /* Light pink/red border */
        border-radius: 6px;
        padding: 60px 20px;
        /* background-color: #ffffff; */
        position: relative;
        background: linear-gradient(10deg, rgba(240, 241, 171, 1) 0%, rgba(203, 255, 255, 1) 100%);
    }

    /* --- Flexbox Rows --- */
    .sector-row {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        flex-wrap: wrap; /* Allows wrapping on smaller screens */
        gap: 15px; /* Space between items */
    }

    .mt-50 {
        margin-top: 50px;
    }

    /* --- Individual Sector Item Setup --- */
    .sector-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: calc(16.66% - 15px); /* 6 items per row on desktop */
        min-width: 150px; /* Prevents items from getting too small */
        position: relative;
    }

    /* Row 2 needs specific width for 7 items */
    .sector-row.mt-50 .sector-item {
        width: calc(14.28% - 15px);
    }

    /* --- Icon Diamond (The Rhombus) --- */
    .icon-diamond {
        width: 70px;
        height: 70px;
        background-color: #ffffff;
        border: 3px solid; /* Color assigned via specific classes */
        transform: rotate(45deg); /* Creates the diamond shape */
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        z-index: 2;
    }

        .icon-diamond i {
            transform: rotate(-45deg); /* Un-rotates the icon inside */
            font-size: 30px;
            color: #333; /* Default icon color */
        }

    /* --- Connector Line (Pointer) --- */
    .connector-line {
        width: 3px;
        height: 30px;
        background-color: #333; /* Default color */
        margin-top: -15px; /* Overlaps with diamond */
        position: relative;
        z-index: 1;
    }

        /* Creating the V-shape pointer at the bottom */
        .connector-line::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            border-left: 10px solid transparent;
            border-right: 10px solid transparent;
            border-top: 10px solid; /* Color assigned via classes */
        }

    /* --- Text Block (Rounded Rectangle) --- */
    .text-block {
        width: 100%;
        background-color: #333; /* Default background */
        color: #ffffff;
        border-radius: 15px;
        padding: 15px 10px;
        text-align: center;
        margin-top: 5px;
        min-height: 100px; /* Ensures uniform height */
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .sector-number {
        font-size: 20px;
        font-weight: bold;
        display: block;
        margin-bottom: 5px;
    }

    .text-block p {
        font-size: 13px;
        line-height: 1.3;
        font-weight: 600;
    }

    /* =========================================
           --- COLOR DEFINITIONS (Matching Image) ---
           ========================================= */

    /* 1. Agri-Food (Green) */
    .color-green .icon-diamond {
        border-color: #2e7d32;
    }

    .color-green .connector-line {
        background-color: #2e7d32;
    }

        .color-green .connector-line::after {
            border-top-color: #2e7d32;
        }

    .color-green .text-block {
        background-color: #2e7d32;
    }

    /* 2. Health (Pink) */
    .color-pink .icon-diamond {
        border-color: #ec407a;
    }

    .color-pink .connector-line {
        background-color: #ec407a;
    }

        .color-pink .connector-line::after {
            border-top-color: #ec407a;
        }

    .color-pink .text-block {
        background-color: #ec407a;
    }

    /* 3. Education (Dark Blue) */
    .color-dark-blue .icon-diamond {
        border-color: #1a237e;
    }

    .color-dark-blue .connector-line {
        background-color: #1a237e;
