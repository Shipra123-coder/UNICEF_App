</style>
<style nonce="@nonce">
    .infographic-container {
        width: 1000px;
        max-width: 100%;
        background-color: #fff;
        border: 2px solid var(--primary-orange);
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        position: relative;
        overflow: hidden; /* Contains slide-in animations */
    }

    /* Title Animation */
    .title {
        color: var(--primary-orange);
        font-size: 20px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 30px;
        opacity: 0;
        animation: fadeInDown 0.8s ease-out forwards;
    }

    .content-layout {
        display: grid;
        grid-template-columns: 100px 1fr 200px; /* Cover, Hub, Text */
        gap: 20px;
        align-items: center;
    }

    /* Policy Covers Animation */
    .policy-covers {
        display: flex;
        flex-direction: column;
        gap: 25px;
        justify-content: center;
        height: 100%;
        opacity: 0;
        animation: fadeInLeft 1s ease-out 0.5s forwards; /* Start after title */
    }

    .cover-placeholder {
        width: 90px;
        height: 110px;
        background-color: var(--cover-bg);
        border-radius: 4px;
        border: 1px solid #ccc;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 10px;
        color: #777;
        text-align: center;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
    }

        .cover-placeholder:hover {
            transform: scale(1.05);
        }

    /* Central Hub and Hexagons Animation */
    .central-hub {
        position: relative;
        width: 400px;
        height: 400px;
        margin: 0 auto;
        opacity: 0;
        animation: fadeIn 1s ease-in 1s forwards; /* Start after title */
    }

    .hex-group {
        position: absolute;
        width: 110px;
        height: 110px;
        transition: all 0.4s ease;
        opacity: 0; /* Hidden initially for staggered entry */
    }

    /* Positions for hexagons based on grid layout */
    .hex-1 {
        top: 0;
        left: 145px;
        animation: popIn 0.5s ease-out 1.2s forwards;
    }
    /* Top */
    .hex-2 {
        top: 75px;
        left: 20px;
        animation: popIn 0.5s ease-out 1.4s forwards;
    }
    /* Top-Left */
    .hex-3 {
        top: 75px;
        left: 270px;
        animation: popIn 0.5s ease-out 1.6s forwards;
    }
    /* Top-Right */
    .hex-4 {
        top: 220px;
        left: 20px;
        animation: popIn 0.5s ease-out 1.8s forwards;
    }
    /* Bottom-Left */
    .hex-5 {
        top: 220px;
        left: 270px;
        animation: popIn 0.5s ease-out 2.0s forwards;
    }
    /* Bottom-Right */
    .hex-6 {
        top: 290px;
        left: 145px;
        animation: popIn 0.5s ease-out 2.2s forwards;
    }
    /* Bottom */

    /* Hexagon Drawing */
    .hexagon {
        fill: #fff;
        stroke: var(--hex-border);
        stroke-width: 3;
        transition: stroke 0.3s ease;
    }

    .hex-group:hover .hexagon {
        stroke: var(--hex-highlight);
    }

    .icon-placeholder {
        font-size: 32px;
        fill: #555;
        transition: fill 0.3s ease;
    }

    .hex-group:hover .icon-placeholder {
        fill: #222;
    }

    /* Center Gear Element */
    .center-element {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 110px;
        height: 110px;
        opacity: 0;
        animation: fadeInRotate 1.5s ease-out 1s forwards;
    }

    /* Policy Text Animation */
    .policy-texts {
        display: flex;
        flex-direction: column;
        gap: 20px;
        justify-content: center;
    }

    .policy-text-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
        opacity: 0;
    }

    /* Matching delays for staggered text entry */
    .text-1 {
        animation: fadeInLeft 0.6s ease-out 1.2s forwards;
    }

    .text-2 {
        animation: fadeInLeft 0.6s ease-out 1.4s forwards;
    }

    .text-3 {
        animation: fadeInLeft 0.6s ease-out 1.6s forwards;
    }

    .text-4 {
        animation: fadeInLeft 0.6s ease-out 1.8s forwards;
    }

    .text-5 {
        animation: fadeInLeft 0.6s ease-out 2.0s forwards;
    }

    .text-6 {
        animation: fadeInLeft 0.6s ease-out 2.2s forwards;
    }

    .policy-label {
        color: var(--policy-text);
        font-weight: bold;
        font-size: 14px;
    }

    .policy-year {
        color: var(--policy-text);
        font-size: 14px;
        margin-bottom: 2px;
    }

    /* Custom Label for Non-Resident */
    .alt-label {
        color: #C08000; /* Gold */
    }

    /* Custom Label for Employment */
    .employment-label {
        color: #CC0066; /* Magenta */
    }

    /* --- Keyframe Animations --- */
    @@keyframes fadeIn {
        to

    {
        opacity: 1;
    }

    }

    @@keyframes fadeInDown {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes fadeInLeft {
        from

    {
        opacity: 0;
        transform: translateX(-30px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

    }

    @@keyframes popIn {
        0%

    {
        opacity: 0;
        transform: scale(0.5);
    }

    70% {
        opacity: 1;
        transform: scale(1.1);
    }

    100% {
        opacity: 1;
        transform: scale(1.0);
    }

    }

    @@keyframes fadeInRotate {
        0%

    {
        opacity: 0;
        transform: translate(-50%, -50%) rotate(-180deg) scale(0.5);
    }

    100% {
        opacity: 1;
        transform: translate(-50%, -50%) rotate(0deg) scale(1.0);
    }

    }

    /* Placeholder icons using text/SVG */
    .hub-icon {
        fill: #9933CC;
    }
</style>
