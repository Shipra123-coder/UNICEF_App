<style nonce="@nonce">
    .container {
        font-family: Arial;
        padding: 20px;
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
    }

    /* Department Card */
    .department {
        margin-bottom: 25px;
        padding: 15px;
        border-radius: 10px;
        background: #f4f6f9;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

        /* Title */
        .department h3 {
            margin-bottom: 10px;
            color: #333;
        }

    /* Activity Grid */
    .activities {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    /* Activity Card */
    .activity {
        padding: 10px 15px;
        border-radius: 8px;
        background: #e0e0e0;
        transition: 0.3s;
        cursor: pointer;
    }

        /* Nodal Highlight */
        .activity.nodal {
            background: #28a745;
            color: white;
            animation: pulse 1.5s infinite;
        }

        /* Hover Effect */
        .activity:hover {
            transform: scale(1.1);
        }

    /* Animation */
    @@keyframes pulse {
        0%

    {
        box-shadow: 0 0 0 0 rgba(40,167,69,0.7);
    }

    70% {
        box-shadow: 0 0 0 10px rgba(40,167,69,0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(40,167,69,0);
    }

    }
</style>

<script nonce="@nonce">
    const data = [
        { dept: "Department of Health", activity: "Health Awareness Camp", nodal: 1 },
        { dept: "Department of Women and Child Development", activity: "Health Awareness Camp", nodal: 0 },
        { dept: "Department of Health", activity: "Village Sanitation Drive", nodal: 1 },
        { dept: "Department of Health", activity: "Water Conservation Campaign", nodal: 1 },
        { dept: "Department of Women and Child Development", activity: "Village Sanitation Drive", nodal: 0 },
        { dept: "Department of Education", activity: "School Inspection Drive", nodal: 1 },
        { dept: "Department of Education", activity: "Labour Inspection", nodal: 1 },
        { dept: "Department of Health", activity: "Women Empowerment Workshop", nodal: 0 },
        { dept: "Department of Women and Child Development", activity: "Women Empowerment Workshop", nodal: 1 },
        { dept: "Department of Water Resources", activity: "Employment Camp", nodal: 1 }
    ];

    // Group by department
    const grouped = {};
    data.forEach(item => {
        if (!grouped[item.dept]) grouped[item.dept] = [];
        grouped[item.dept].push(item);
    });

    // Render
    const container = document.getElementById("dashboard");

    for (let dept in grouped) {
        let deptDiv = document.createElement("div");
        deptDiv.className = "department";

        let title = `<h3>${dept}</h3>`;
        let activities = `<div class="activities">`;

        grouped[dept].forEach(a => {
            activities += `<div class="activity ${a.nodal ? 'nodal' : ''}">
                            ${a.activity}
                          </div>`;
        });

        activities += `</div>`;
        deptDiv.innerHTML = title + activities;

        container.appendChild(deptDiv);
    }
</script>
