@{
    ViewData["Title"] = "Activity";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<style nonce="@nonce">
        /* =========================================
       DEPARTMENT TABLE CSS
    ========================================= */
    .card-title {
        background: #d2d2d2;
        padding: 10px;
        font-weight: 700;
    }
        .margin-top-200{
            margin-top:200px;
            width:85%
        }

    /* =========================================
   TABLE BORDERED CSS
========================================= */

    .table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
    }

    .table-bordered {
        border: 1px solid #dbeafe;
    }

        .table-bordered th,
        .table-bordered td {
            border: 1px solid #dbeafe;
            padding: 12px;
            vertical-align: top;
        }

    /* =========================================
   TABLE HEADER
========================================= */

    .table thead th {
        background: #d2d2d2;
        color: #000;
        font-size: 15px;
        font-weight: 700;
        text-align: left;
    }

    /* =========================================
   TABLE BODY
========================================= */

    .table tbody td {
        font-size: 14px;
        color: #334155;
        line-height: 1.6;
    }

    /* =========================================
   INNER TABLE
========================================= */

    .table-sm th,
    .table-sm td {
        padding: 8px;
        font-size: 13px;
    }

    /* =========================================
   HOVER EFFECT
========================================= */

    .table tbody tr:hover {
        background: #f8fbff;
    }

    /* =========================================
   RESPONSIVE
========================================= */

    .table-responsive {
        overflow-x: auto;
    }

    /* =========================================
   PRINT CSS
========================================= */

    @@media print {

        .table,
        .table-bordered {
            width: 100%;
            border-collapse: collapse;
        }

            .table th,
            .table td {
                border: 1px solid #000 !important;
            }
    }

        .table-responsive {
            overflow-x: auto;
        }

        .department-table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
        }

            .department-table thead th {
                background: #d2d2d2;
                color: #000;
                padding: 14px;
                font-size: 15px;
                font-weight: 700;
                text-align: left;
                border: 1px solid #dbeafe;
            }

            .department-table tbody td {
                padding: 12px;
                border: 1px solid #dbeafe;
                vertical-align: top;
                font-size: 14px;
                color: #334155;
            }

        /* =========================================
       INNER TABLE
    ========================================= */

        .inner-department-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 0;
        }

            .inner-department-table thead th {
                background: #dbeafe;
                color: #1e293b;
                padding: 10px;
                font-size: 13px;
                font-weight: 600;
                border: 1px solid #bfdbfe;
            }

            .inner-department-table tbody td {
                padding: 10px;
                border: 1px solid #bfdbfe;
                font-size: 13px;
                color: #475569;
            }

        /* =========================================
       HOVER
    ========================================= */

        .department-table tbody tr:hover {
            background: #f8fbff;
        }

        /* =========================================
       PRINT CSS
    ========================================= */

        @@media print {

            .department-table,
            .inner-department-table {
                width: 100%;
                border-collapse: collapse;
            }

                .department-table th,
                .department-table td,
                .inner-department-table th,
                .inner-department-table td {
                    border: 1px solid #000 !important;
                }
        }

    /* =========================================
   SDG TABLE MAIN
========================================= */

    .sdg-table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
    }

        .sdg-table thead th {
            background: #d2d2d2;
            color: #000;
            padding: 14px;
            font-size: 15px;
            font-weight: 700;
            text-align: left;
            border: 1px solid #dbeafe;
            vertical-align: middle;
        }

        .sdg-table tbody td {
            padding: 12px;
            border: 1px solid #dbeafe;
            vertical-align: top;
            font-size: 14px;
            color: #334155;
        }

    /* =========================================
   INNER TARGET TABLE
========================================= */

    .inner-target-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0;
        background: #fff;
    }

        .inner-target-table thead th {
            background: #dbeafe;
            color: #1e293b;
            padding: 10px;
            font-size: 13px;
            font-weight: 600;
            border: 1px solid #bfdbfe;
        }

        .inner-target-table tbody td {
            padding: 10px;
            border: 1px solid #bfdbfe;
            font-size: 13px;
            color: #475569;
            line-height: 1.6;
        }

