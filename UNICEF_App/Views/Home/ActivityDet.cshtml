@{
    ViewData["Title"] = "Activity";
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<style nonce="@nonce">
        /* =========================================
               DEPARTMENT TABLE CSS
            ========================================= */
        .card-title {
            background: #d2d2d2;
            padding: 10px;
            font-weight: 700;
        }

        .card-titlesubactivity {
            padding: 10px;
            font-weight: 700;
            border: 1px solid #dbeafe;
            margin-bottom: 0px;
        }

        .margin-top-200 {
            margin-top: 240px;
            width: 85%
        }

        /* =========================================
           TABLE BORDERED CSS
        ========================================= */

        .table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
            margin-bottom: 0px;
        }

        .table-bordered {
            border: 1px solid #dbeafe;
        }

            .table-bordered th,
            .table-bordered td {
                border: 1px solid #dbeafe;
                padding: 12px;
                vertical-align: top;
            }

        /* =========================================
           TABLE HEADER
        ========================================= */

        .table thead th {
            background: #d2d2d2;
            color: #000;
            font-size: 15px;
            font-weight: 700;
            text-align: left;
        }

        /* =========================================
           TABLE BODY
        ========================================= */

        .table tbody td {
            font-size: 14px;
            color: #334155;
            line-height: 1.6;
        }

        /* =========================================
           INNER TABLE
        ========================================= */

        .table-sm th,
        .table-sm td {
            padding: 8px;
            font-size: 13px;
        }

        /* =========================================
           HOVER EFFECT
        ========================================= */

        .table tbody tr:hover {
            background: #f8fbff;
        }

        /* =========================================
           RESPONSIVE
        ========================================= */

        .table-responsive {
            overflow-x: auto;
        }

        .description-text {
            border: 1px solid #dbeafe !important;
            padding: 10px;
        }
        /* =========================================
           PRINT CSS
        ========================================= */
        @@media print {
            .table, .table-bordered {
                width: 100%;
                border-collapse: collapse;
            }

                .table th,
                .table td {
                    border: 1px solid #000 !important;
                }
        }

        .table-responsive {
            overflow-x: auto;
        }

        .department-table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
        }

            .department-table thead th {
                background: #d2d2d2;
                color: #000;
                padding: 14px;
                font-size: 15px;
                font-weight: 700;
                text-align: left;
                border: 1px solid #dbeafe;
            }

            .department-table tbody td {
                padding: 12px;
                border: 1px solid #dbeafe;
                vertical-align: top;
                font-size: 14px;
                color: #334155;
            }

        /* =========================================
               INNER TABLE
            ========================================= */

        .inner-department-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 0;
        }

            .inner-department-table thead th {
                background: #dbeafe;
                color: #1e293b;
                padding: 10px;
                font-size: 13px;
                font-weight: 600;
                border: 1px solid #bfdbfe;
            }

            .inner-department-table tbody td {
                padding: 10px;
                border: 1px solid #bfdbfe;
                font-size: 13px;
                color: #475569;
            }

        /* =========================================
               HOVER
            ========================================= */

        .department-table tbody tr:hover {
            background: #f8fbff;
        }

        /* =========================================
               PRINT CSS
            ========================================= */

        @@media print {

            .department-table,
            .inner-department-table {
                width: 100%;
                border-collapse: collapse;
            }

                .department-table th,
                .department-table td,
                .inner-department-table th,
                .inner-department-table td {
                    border: 1px solid #000 !important;
                }
        }

        /* =========================================
           SDG TABLE MAIN
        ========================================= */

        .sdg-table {
            width: 100%;
            border-collapse: collapse;
            background: #fff;
        }

            .sdg-table thead th {
                background: #d2d2d2;
                color: #000;
                padding: 14px;
                font-size: 15px;
                font-weight: 700;
                text-align: left;
                border: 1px solid #dbeafe;
                vertical-align: middle;
            }

            .sdg-table tbody td {
                padding: 12px;
                border: 1px solid #dbeafe;
                vertical-align: top;
                font-size: 14px;
                color: #334155;
            }

        /* =========================================
           INNER TARGET TABLE
        ========================================= */

        .inner-target-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 0;
            background: #fff;
        }

            .inner-target-table thead th {
                background: #dbeafe;
                color: #1e293b;
                padding: 10px;
                font-size: 13px;
                font-weight: 600;
                border: 1px solid #bfdbfe;
            }

            .inner-target-table tbody td {
                padding: 10px;
                border: 1px solid #bfdbfe;
                font-size: 13px;
                color: #475569;
                line-height: 1.6;
            }

        /* =========================================
           GOAL TITLE
        ========================================= */

        .sdg-table strong {
            color: #0f172a;
            font-size: 15px;
            font-weight: 700;
        }

        /* =========================================
           HOVER EFFECT
        ========================================= */

        .sdg-table tbody tr:hover {
            background: #f8fbff;
        }

        /* =========================================
           RESPONSIVE
        ========================================= */

        .table-responsive {
            overflow-x: auto;
        }

        /* =========================================
           PRINT CSS
        ========================================= */

        @@media print {

            .sdg-table,
            .inner-target-table {
                width: 100%;
                border-collapse: collapse;
            }

                .sdg-table th,
                .sdg-table td,
                .inner-target-table th,
                .inner-target-table td {
                    border: 1px solid #000 !important;
                }
        }


        .report-header {
            width: 100%;
            border: 1px solid #1d3d73;
            font-family: Arial, Helvetica, sans-serif;
        }

        .report-header-top {
            background: #1f3b73 !important;
            color: #fff !important;
            text-align: center;
            padding: 18px 20px;
        }

            .report-header-top h1 {
                margin: 0;
                font-size: 18px !important;
                font-weight: 700;
                text-transform: uppercase;
            }

            .report-header-top p {
                margin: 8px 0;
                font-size: 14px !important;
                color: #fff !important;
            }

        .report-title {
            font-size: 16px !important;
            font-weight: 700;
            line-height: 1.5;
        }

        /* Renamed from .header-bottom */
        .report-header-footer {
            background: #3c78b5 !important;
            color: #fff !important;
            text-align: center;
            padding: 12px 20px;
        }

            .report-header-footer h2 {
                margin: 0;
                font-size: 16px !important;
                font-weight: 700;
                color: #fff !important;
            }

            .report-header-footer p {
                margin: 5px 0 0;
                font-size: 13px !important;
                color: #fff !important;
            }
        /*=========================
    Print
    =========================*/

        @@media print {

            * {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .print-header-top {
                background: #1f3b73 !important;
                color: #fff !important;
            }

            .print-header-bottom {
                background: #3c78b5 !important;
                color: #fff !important;
            }
        }
</style>
