   GOAL TITLE
========================================= */

    .sdg-table strong {
        color: #0f172a;
        font-size: 15px;
        font-weight: 700;
    }

    /* =========================================
   HOVER EFFECT
========================================= */

    .sdg-table tbody tr:hover {
        background: #f8fbff;
    }

    /* =========================================
   RESPONSIVE
========================================= */

    .table-responsive {
        overflow-x: auto;
    }

    /* =========================================
   PRINT CSS
========================================= */

    @@media print {

        .sdg-table,
        .inner-target-table {
            width: 100%;
            border-collapse: collapse;
        }

            .sdg-table th,
            .sdg-table td,
            .inner-target-table th,
            .inner-target-table td {
                border: 1px solid #000 !important;
            }
    }
</style>
