<script nonce="@nonce">
    document.addEventListener('DOMContentLoaded', function () {

        let guid = $('#ActivityGuid').val();

        if (guid) {
            printActivity.loadFullData(guid); // 👈 ye tum already bana chuki ho
        }
        $("#btnPrint").on("click", function () {
            printActivity.printDiv('@nonce');
    });
    });
</script>