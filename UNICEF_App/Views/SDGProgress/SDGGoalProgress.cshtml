<style nonce="@nonce">
    /* =========================
           TOP COUNT BOX DESIGN
        ========================= */

    .top-count-section {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 15px;
        margin-bottom: 45px;
        position: relative;
        z-index: 5;
        margin-top: 20px;
    }

    .count-card {
        position: relative;
        overflow: hidden;
        background: #fff;
        border-radius: 18px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 18px;
        border: 1px solid #dbe7ff;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
        transition: all .4s ease;
        z-index: 1;
    }

        /* Background Circle */
        .count-card::before {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            background: rgba(13,110,253,.08);
            border-radius: 50%;
            right: -45px;
            top: -45px;
            transition: all .5s ease;
        }

        /* Animated Gradient Border */
        .count-card::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 18px;
            padding: 2px;
            background: linear-gradient(135deg,#0d6efd,#20c997,#0dcaf0);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: .4s;
        }

        /* Show Gradient Border */
        .count-card:hover::after {
            opacity: 1;
        }

        .count-card:hover,
        .count-card.active {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 45px rgba(13,110,253,.25);
            border-color: transparent;
            background: linear-gradient(135deg,#ffffff,#f5faff);
        }

    .count-icon {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: linear-gradient(135deg,#0ea5e9,#2563eb);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        color: #fff;
        flex-shrink: 0;
    }

    .count-card h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 800;
        color: #082f75;
        line-height: 1;
    }

    .count-card p {
        margin: 6px 0 0;
        font-size: 15px;
        color: #475569;
        font-weight: 600;
    }

    /* Double Card */
    .double-count-card {
        background: #ffffff;
        border-radius: 15px;
        padding: 15px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        border: 1px solid #dbe7ff;
        box-shadow: 0 10px 25px rgba(0,0,0,0.06);
        position: relative;
        overflow: hidden;
        transition: .3s;
        /* 2 cards ki width */
        grid-column: span 2;
    }

        .double-count-card::before {
            content: '';
            position: absolute;
            width: 75px;
            height: 75px;
            background: #eff6ff;
            border-radius: 50%;
            right: -30px;
            top: -30px;
        }

        .double-count-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.10);
        }

    .double-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .double-card-item {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .double-card-divider {
        width: 1px;
        height: 40px;
        background: #dbe7ff;
        margin: 0 15px;
    }

    .double-card-footer {
        margin-top: 8px;
        text-align: center;
        font-size: 16px;
        font-weight: 700;
        color: #2563eb;
        /*text-transform: uppercase;*/
        letter-spacing: .5px;
    }

    .double-card-item h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 800;
        color: #082f75;
    }

    .double-card-item p {
        margin: 4px 0 0;
        font-size: 14px;
        color: #475569;
        font-weight: 600;
    }
    /* RESPONSIVE */

    @@media(max - width:1200px) {
        .top-count-section {
            grid-template-columns: repeat(3,1fr);
        }
    }

    @@media(max - width:768px) {
        .top-count-section {
            grid-template-columns: repeat(2,1fr);
        }
    }

    @@media(max - width:576px) {
        .top-count-section {
            grid-template-columns: 1fr;
        }
    }
</style>
