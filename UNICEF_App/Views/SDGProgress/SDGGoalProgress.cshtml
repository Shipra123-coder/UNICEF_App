<script nonce="@nonce">
    document.addEventListener("DOMContentLoaded", function () {
        sdggoals.loadCoverPagesBySDGGoals();
    });
    // =========================
    // WITHOUT JQUERY
    // EVENT LISTENER
    // =========================
    document.addEventListener("click", function (e) {
        let departmentCard =
            e.target.closest(".countDepartmentCard");
        if (departmentCard) {
            // =========================
            // GET DATA ATTRIBUTE
            // =========================
            let goalId =
                departmentCard.getAttribute("data-goalid");

            console.log(goalId);
            // =========================
            // FUNCTION CALL
            // =========================
            sdggoals.loadDepartmentActivityList(goalId);
        }
        // =========================
        // AGENCY CARD
        // =========================
        let agencyCard =
            e.target.closest(".countAgencyCard");
        if (agencyCard) {
            let goalId =
                agencyCard.getAttribute("data-goalid");
            sdggoals.loadAgencyActivityList(goalId);
        }
        // =========================
        // SECTOR CARD
        // =========================
        let SectorCard =
            e.target.closest(".countSectorCard");
        if (SectorCard) {
            let goalId =
                SectorCard.getAttribute("data-goalid");
            sdggoals.loadSectorActivityList(goalId);
        }
        // =========================
        // ACTIVITY CARD
        // =========================
        let activityCard =
            e.target.closest(".countActivityCard");
        if (activityCard) {
            let goalId = activityCard.getAttribute("data-goalid");
            sdggoals.loadActivityList(goalId);
        }
    });

</script>