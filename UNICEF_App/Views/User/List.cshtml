@model IEnumerable<MO.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
}
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<div class="container-fluid mt-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0">User Directory</h3>
            <p class="text-muted mb-0">Manage registered users, roles, and status</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill"></i> Add New User
        </a>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center">
                <div class="col-md-4">
                    <input type="text" id="tableSearch" class="form-control" placeholder="Search by SSOID, Name, or Email...">
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="userTable">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">#</th>
                            <th>SSOID</th>
                            <th>Name</th>
                            <th>Contact</th>
                            <th>Designation</th>
                            <th>Status</th>
                            <th>Created On</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-3 text-muted">@index</td>
                                    <td>
                                        <span class="fw-semibold text-primary">@user.SSOID</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold">@user.Name</div>
                                        <small class="text-muted">@user.DisplayName</small>
                                    </td>
                                    <td>
                                        <div><i class="bi bi-envelope text-muted"></i> @(user.EmailId ?? "-")</div>
                                        <small class="text-muted"><i class="bi bi-telephone text-muted"></i> @(user.Mobile ?? "-")</small>
                                    </td>
                                    <td>@(user.Designation ?? "-")</td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @(user.CreatedDate.HasValue ? user.CreatedDate.Value.ToString("dd MMM yyyy") : "-")
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm px-3" title="Edit User">
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    No users found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@nonce">
        // Real-time table filter
        document.getElementById('tableSearch').addEventListener('keyup', function () {
            let filter = this.value.toLowerCase();
            let rows = document.querySelectorAll('#userTable tbody tr');

            rows.forEach(row => {
                let text = row.innerText.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}