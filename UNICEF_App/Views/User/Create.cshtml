@model MO.ViewModels.UserCreateViewModel

@{
    ViewData["Title"] = "Create User";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
}
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}

<div class="container mt-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0 text-white"><i class="bi bi-person-plus-fill"></i>Create New User</h5>
        </div>
        <div class="card-body p-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Create" method="post" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Account Information -->
                <h6 class="text-muted text-uppercase mb-3 pb-1 border-bottom">Account Information</h6>

                <!-- Row 1: Basic Details -->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Name" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <input asp-for="Name" class="form-control" placeholder="Enter username" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DisplayName" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <input asp-for="DisplayName" class="form-control" placeholder="Full name" />
                        <span asp-validation-for="DisplayName" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SSOID" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <input asp-for="SSOID" class="form-control" placeholder="SSO login ID" />
                        <span asp-validation-for="SSOID" class="text-danger"></span>
                    </div>
                </div>

                <!-- Row 2: Designation, Password & Confirm Password -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="Designation" class="form-label fw-bold"></label>
                        <input asp-for="Designation" class="form-control" placeholder="e.g. Officer, HOD" />
                        <span asp-validation-for="Designation" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Password" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <!-- Hierarchy & Dynamic Level Mapping -->
                <h6 class="text-muted text-uppercase mb-3 pb-1 border-bottom">Hierarchy & Mapping</h6>
                <div class="row g-3 mb-4">
                    <!-- Group Dropdown -->
                    <div class="col-md-4">
                        <label asp-for="GroupId" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <select asp-for="GroupId"
                                asp-items="@(new SelectList(Model.GroupList, "Value", "Text", Model?.GroupId))"
                                class="form-select"
                                id="ddlGroup">
                            <option value="">-- Select Group --</option>
                        </select>
                        <span asp-validation-for="GroupId" class="text-danger"></span>
                    </div>

                    <!-- User Level Dropdown -->
                    <div class="col-md-4">
                        <label asp-for="UserLevel" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <select asp-for="UserLevel"
                                asp-items="@(new SelectList(Model.UserLevelList, "Value", "Text", Model?.UserLevel))"
                                class="form-select"
                                id="ddlUserLevel">
                            <option value="">-- Select Level --</option>
                        </select>
                        <span asp-validation-for="UserLevel" class="text-danger"></span>
                    </div>

                    <!-- Department Dropdown (Shows only on Department Level - Id 1) -->
                    <div class="col-md-4" id="departmentContainer" style="display:none;">
                        <label asp-for="DepartmentId" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <select asp-for="DepartmentId"
                                asp-items="@(new SelectList(Model.DepartmentList, "Value", "Text", Model?.DepartmentId))"
                                class="form-select"
                                id="ddlDepartment">
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>

                    <!-- Agency Dropdown (Shows only on Agency Level - Id 2) -->
                    <div class="col-md-4" id="agencyContainer" style="display:none;">
                        <label asp-for="AgencyId" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <select asp-for="AgencyId"
                                asp-items="@(new SelectList(Model.AgencyList, "Value", "Text", Model?.AgencyId))"
                                class="form-select"
                                id="ddlAgency">
                            <option value="">-- Select Agency --</option>
                        </select>
                        <span asp-validation-for="AgencyId" class="text-danger"></span>
                    </div>
                </div>

                <!-- Contact Details -->
                <h6 class="text-muted text-uppercase mb-3 pb-1 border-bottom">Contact Details</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="Mobile" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <input asp-for="Mobile" class="form-control" maxlength="10" placeholder="10-digit mobile" />
                        <span asp-validation-for="Mobile" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="WhatsappMobile" class="form-label fw-bold"></label>
                        <input asp-for="WhatsappMobile" class="form-control" maxlength="10" placeholder="WhatsApp number" />
                        <span asp-validation-for="WhatsappMobile" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EmailId" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <input asp-for="EmailId" class="form-control" placeholder="user@domain.com" />
                        <span asp-validation-for="EmailId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row align-items-center mt-3">
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="chkActive">
                            <label class="form-check-label fw-bold" for="chkActive">Active Account</label>
                        </div>
                    </div>
                    <div class="col-md-8 text-end">
                        <button type="reset" class="btn btn-secondary px-4 me-2">Reset</button>
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Save User</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@nonce">
        $(document).ready(function () {
            function toggleLevelDropdowns() {
                var userLevel = $('#ddlUserLevel').val();

                if (userLevel === "1") {
                    $('#departmentContainer').slideDown();
                    $('#agencyContainer').slideUp();
                    $('#ddlAgency').val('');
                }
                else if (userLevel === "2") {
                    $('#agencyContainer').slideDown();
                    $('#departmentContainer').slideUp();
                    $('#ddlDepartment').val('');
                }
                else {
                    $('#departmentContainer').slideUp();
                    $('#agencyContainer').slideUp();
                    $('#ddlDepartment').val('');
                    $('#ddlAgency').val('');
                }
            }

            $('#ddlUserLevel').on('change', toggleLevelDropdowns);
            toggleLevelDropdowns();
        });
    </script>
}