@model MO.ViewModels.UserEditViewModel

@{
    ViewData["Title"] = "Edit User";
    Layout = "~/Views/Shared/_LayoutIn.cshtml";
    var nonce = Context.Items["CSPNonce"]?.ToString();
}

<div class="container mt-2">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="fa fa-pencil-square-o mr-2"></i> Edit User: @Model.DisplayName</h5>
            <a asp-action="UserList" class="btn btn-sm btn-outline-dark font-weight-bold">
                <i class="fa fa-arrow-left mr-1"></i> Back to List
            </a>
        </div>
        <div class="card-body p-4">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fa fa-check-circle mr-1"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fa fa-exclamation-triangle mr-1"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Edit" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Hidden Identifiers for Update -->
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Guid" />

                <!-- Account Information -->
                <h6 class="text-muted text-uppercase mb-3 pb-1 border-bottom">Account Information</h6>

                <!-- Row 1: Basic Details -->
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <input asp-for="Name" class="form-control bg-light" readonly placeholder="Enter username" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DisplayName" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <input asp-for="DisplayName" class="form-control" placeholder="Full name" />
                        <span asp-validation-for="DisplayName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SSOID" class="form-label fw-bold"></label>
                        <input asp-for="SSOID" class="form-control bg-light" readonly placeholder="SSO login ID" />
                        <span asp-validation-for="SSOID" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Row 2: Designation & Optional Password Change -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="Designation" class="form-label fw-bold"></label>
                        <input asp-for="Designation" class="form-control" placeholder="e.g. Officer, HOD" />
                        <span asp-validation-for="Designation" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Password" class="form-label fw-bold">New Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Leave blank to keep unchanged" />
                        <span class="text-muted" style="font-size: 11px;">Fill only if you wish to change current password.</span>
                        <span asp-validation-for="Password" class="text-danger small d-block"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter new password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Hierarchy & Dynamic Level Mapping -->
                <h6 class="text-muted text-uppercase mb-3 pb-1 border-bottom">Hierarchy & Mapping</h6>
                <div class="row g-3 mb-4">
                    <!-- Group Dropdown -->
                    <div class="col-md-4">
                        <label asp-for="GroupId" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <select asp-for="GroupId"
                                asp-items="@(new SelectList(Model.GroupList, "Value", "Text", Model?.GroupId))"
                                class="form-select"
                                id="ddlGroup">
                            <option value="">-- Select Group --</option>
                        </select>
                        <span asp-validation-for="GroupId" class="text-danger small"></span>
                    </div>

                    <!-- User Level Dropdown -->
                    <div class="col-md-4">
                        <label asp-for="UserLevel" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <select asp-for="UserLevel"
                                asp-items="@(new SelectList(Model.UserLevelList, "Value", "Text", Model?.UserLevel))"
                                class="form-select"
                                id="ddlUserLevel">
                            <option value="">-- Select Level --</option>
                        </select>
                        <span asp-validation-for="UserLevel" class="text-danger small"></span>
                    </div>

                    <!-- Department Dropdown (Level 1) -->
                    <div class="col-md-4" id="departmentContainer" style="display:none;">
                        <label asp-for="DepartmentId" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <select asp-for="DepartmentId"
                                asp-items="@(new SelectList(Model.DepartmentList, "Value", "Text", Model?.DepartmentId))"
                                class="form-select"
                                id="ddlDepartment">
                            <option value="">-- Select Department --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>

                    <!-- Agency Dropdown (Level 2) -->
                    <div class="col-md-4" id="agencyContainer" style="display:none;">
                        <label asp-for="AgencyId" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <select asp-for="AgencyId"
                                asp-items="@(new SelectList(Model.AgencyList, "Value", "Text", Model?.AgencyId))"
                                class="form-select"
                                id="ddlAgency">
                            <option value="">-- Select Agency --</option>
                        </select>
                        <span asp-validation-for="AgencyId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Contact Details -->
                <h6 class="text-muted text-uppercase mb-3 pb-1 border-bottom">Contact Details</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="Mobile" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <input asp-for="Mobile" class="form-control" maxlength="10" placeholder="10-digit mobile" />
                        <span asp-validation-for="Mobile" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="WhatsappMobile" class="form-label fw-bold"></label>
                        <input asp-for="WhatsappMobile" class="form-control" maxlength="10" placeholder="WhatsApp number" />
                        <span asp-validation-for="WhatsappMobile" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EmailId" class="form-label fw-bold"></label><span class="text-danger">*</span>
                        <input asp-for="EmailId" class="form-control" placeholder="user@domain.com" />
                        <span asp-validation-for="EmailId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row align-items-center mt-3">
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="chkActive">
                            <label class="form-check-label fw-bold" for="chkActive">Active Account</label>
                        </div>
                    </div>
                    <div class="col-md-8 text-end">
                        <a asp-action="UserList" class="btn btn-secondary px-4 me-2">Cancel</a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="fa fa-save mr-1"></i> Update User
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@nonce">
        $(document).ready(function () {
            function toggleLevelDropdowns() {
                var userLevel = $('#ddlUserLevel').val();

                if (userLevel === "1") {
                    $('#departmentContainer').slideDown();
                    $('#agencyContainer').slideUp();
                }
                else if (userLevel === "2") {
                    $('#agencyContainer').slideDown();
                    $('#departmentContainer').slideUp();
                }
                else {
                    $('#departmentContainer').slideUp();
                    $('#agencyContainer').slideUp();
                }
            }

            // Bind change event
            $('#ddlUserLevel').on('change', function () {
                // Clear values only on manual user change
                var userLevel = $(this).val();
                if (userLevel === "1") {
                    $('#ddlAgency').val('');
                } else if (userLevel === "2") {
                    $('#ddlDepartment').val('');
                } else {
                    $('#ddlDepartment').val('');
                    $('#ddlAgency').val('');
                }
                toggleLevelDropdowns();
            });

            // Initial trigger on page load with existing values
            toggleLevelDropdowns();
        });
    </script>
}