    <script nonce="@nonce">
        const playPauseBtns = document.querySelectorAll('.play-btn');
        const audioElements = document.querySelectorAll('.audio-element');
        const seekBars = document.querySelectorAll('.seek-bar');
        playPauseBtns.forEach((btn, index) => {
            const audio = audioElements[index];
            const seekBar = seekBars[index];
            if (audio && seekBar) {
                btn.addEventListener('click', () => {
                    if (audio.paused) {
                        audio.play();
                        btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#fff" width="24" height="24"><path d="M6 6h4v12H6zm8 0h4v12h-4z"></path></svg>`;
                    } else {
                        audio.pause();
                        btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#fff" width="24" height="24"><path d="M8 5v14l11-7z"></path></svg>`;
                    }
                });
                audio.addEventListener('timeupdate', () => {
                    seekBar.max = audio.duration;
                    seekBar.value = audio.currentTime;
                });
                seekBar.addEventListener('input', () => {
                    audio.currentTime = seekBar.value;
                });
            }
        });
    </script>
    <script nonce="@nonce">
        document.addEventListener('DOMContentLoaded', function () {
            const accbtn = document.querySelector('.darkbtn');
            const body = document.body;
            if (accbtn) {
                if (localStorage.getItem('darkMode') === 'enabled') {
                    body.classList.add('dark');
                    accbtn.classList.add('active');
                }
                accbtn.addEventListener('click', function () {
                    body.classList.toggle('dark');
                    accbtn.classList.toggle('active');
                    if (body.classList.contains('dark')) {
                        localStorage.setItem('darkMode', 'enabled');
                    } else {
                        localStorage.setItem('darkMode', 'disabled');
                    }
                });
            }
        });
    </script>
    <script nonce="@nonce">
        let isFontSizeIncreased = false;
        function toggleFontSize(button) {
            const htmlElement = document.documentElement;
            const defaultFontSize = 16;
            if (isFontSizeIncreased) {
                htmlElement.style.fontSize = "100%";
                isFontSizeIncreased = false;
                if (button.querySelector('span')) button.querySelector('span').textContent = "Bigger Text";
                button.classList.remove('active');
            } else {
                const currentFontSize = parseFloat(window.getComputedStyle(htmlElement).fontSize) || defaultFontSize;
                const newFontSize = currentFontSize * 1.1;
                htmlElement.style.fontSize = newFontSize + "px";
                isFontSizeIncreased = true;
                if (button.querySelector('span')) button.querySelector('span').textContent = "Smaller Text";
                button.classList.add('active');
            }
        }
    </script>
    <script nonce="@nonce">
        let linksHighlighted = false;
        function highlightLinks(button) {
            const links = document.querySelectorAll('a');
            if (linksHighlighted) {
                links.forEach(link => {
                    link.style.color = "";
                    link.style.removeProperty("text-decoration");
                });
                linksHighlighted = false;
                button.classList.removeClass('active');
            } else {
                links.forEach(link => {
                    link.style.color = "#d50707";
                    link.style.setProperty("text-decoration", "underline", "important");
                });
                linksHighlighted = true;
                button.classList.add('active');
            }
        }
    </script>
    <script nonce="@nonce">
        let isCursorIncreased = false;
        function increaseCursorSize(button) {
            const body = document.body;
            if (isCursorIncreased) {
                body.style.cursor = "";
                button.classList.remove('active');
                isCursorIncreased = false;
            } else {
                body.style.cursor = "url('public/img/icons/mouse-pointer.svg'), auto";
                button.classList.add('active');
                isCursorIncreased = true;
            }
        }
    </script>
