            $('#accessClose').click(function () {
                $('#accessMain').fadeOut();
                $('.toggleSidemenu, .accessOpen').removeClass('active');
            });

            var btnAccessOpen = document.querySelector('.accessOpen');
            if (btnAccessOpen) {
                btnAccessOpen.addEventListener('click', function () {
                    const accessMain = document.getElementById('accessMain');
                    if (accessMain) accessMain.style.display = 'block';
                });
            }

            var btnAccessClose = document.getElementById('accessClose');
            if (btnAccessClose) {
                btnAccessClose.addEventListener('click', function () {
                    const accessMain = document.getElementById('accessMain');
                    if (accessMain) accessMain.style.display = 'none';
                });
            }
        });
    </script>
